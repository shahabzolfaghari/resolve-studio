      thinking_signature: "\022\230\023\n\225\023\001i\024}\023\362\355d\v\231\000\bek\b\373%\344\206o\264\364&\241\332#\303O\032\003\026\314\376EX\256\213\006\302\320\333\251\245\334\317!\035*\036R\320\271\025\271c\022\3433\345\tFl\336F\313]\017\354\"P\240A?\241\016\251$\034?Z%\242\341\025\235\203\326\205q\357\340\357\fE=\340\022>\f\351N\361k\364\273h\210\234\271\033\364\204Za\270\032\334q\307\032[\241\033;\357l\310\305h\025\033#\a=\2244\261s\\}G\347~\256Jl\223Y\266\331s`O\"\324\200\351\210\250DZ\215\032*\206\310C\236\r\233\267\261\345\217H\355GcT\255\223\324\261Fy\232\266)\274\372\203m\346\234T`J)~\0171\224\203\021\346\025\211#\311\322N\361\266p\237]\301\354L\324\021\305\f\316!\217\344\371\224\214\326\252x\260\203\206\222a\370\254\375EQ*\004\254\375\343YV\367\250W\315\371\016\337\301\344\352Z\217\005\222\336V\0333l_j\236\260f\"K\302\001\364]\326W\027\336\256\243\304\206\023\020\fa\360\203e\"\376\321\345s\036\253A3tn\211\365H/\350gj\360p\177\254\a\374\241lq\344q\314\375s~t\270\004\311-\"\331\272\226iPl\3315\222x\374\335\327#\330\341\005;\\Zz\322\177\032\246\367\004\360_=\333c\322\303\247h\254\310\351\333\342\274\353\254\351\000o\316k\032\\\254\205\027^\315a3\232\202`\335Ge\352^\302\230,\341\321\340\022\342J\251\344\344M\266\304|\3132\274\224\324\267\357\256\222m\307*\037\034\211\274\377J\263E\302\217\037\304V{A\353\224\r-WV7\347\201p\261Q\267\325\316\203\005J\0200\317\265\252\235p,I\215K\357%\271I\232B\205\"\315\a\036\213|\273L<\241g\n\202b\r\020\363\000\236\250\334\374L\307\345\333\344&\314\314(\236>\201\271\250\316\302h\326gO~\233\264\364\240!\325\333>V\244\206\326mC\334\006;\271\n\023\224\205\305\307\305<\262:2\021\274Z\202_\365\301\354\026\336P6\277\316q?X\203]@\275v\363f\216\0025\032K\310E\375\003?\332\252cB\334\265tG\351\247\255P\037~\254\322`\202\233\200\257HF@\326\344<\177\2545\033\036\257{\025X\201 Ey\230Okd;\373\300\347\200\276\303r\f\036\335\b;0z\260\366_`\324$\260\347\205\367\307\214e\313I\026\312d\331\347n\a\240\343\332\251\r\242\001q1\234\225\302C\230