    content: "package com.example.ui.components\n\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.rememberScrollState\nimport androidx.compose.foundation.shape.RoundedCornerShape\nimport androidx.compose.foundation.verticalScroll\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.filled.AutoAwesome\nimport androidx.compose.material.icons.filled.WbSunny\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.Composable\nimport androidx.compose.ui.Alignment\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.draw.clip\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.platform.testTag\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport com.example.model.ColorGradeSettings\nimport com.example.ui.theme.*\n\n@Composable\nfun EffectsPanel(\n    settings: ColorGradeSettings,\n    onSettingsChange: (ColorGradeSettings) -> Unit,\n    modifier: Modifier = Modifier\n) {\n    Card(\n        modifier = modifier\n            .testTag(\"effects_panel\")\n            .padding(4.dp),\n        colors = CardDefaults.cardColors(containerColor = StudioSurfaceVariant),\n        shape = RoundedCornerShape(12.dp)\n    ) {\n        Column(\n            modifier = Modifier\n                .padding(10.dp)\n                .verticalScroll(rememberScrollState())\n        ) {\n            // Section 1: Samsung S24 Ultra Log CST\n            Row(\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.SpaceBetween,\n                modifier = Modifier.fillMaxWidth()\n            ) {\n                Row(verticalAlignment = Alignment.CenterVertically) {\n                    Icon(Icons.Default.WbSunny, contentDescription = null, tint = ResolveAmber, modifier = Modifier.size(16.dp))\n                    Spacer(modifier = Modifier.width(6.dp))\n                    Text(\n                        text = \"SAMSUNG S24 LOG CST\",\n                        color = TextPrimary,\n                        fontSize = 11.sp,\n                        fontWeight = FontWeight.Bold,\n                        letterSpacing = 1.sp\n                    )\n                }\n\n                Switch(\n                    checked = settings.samsungLogTransform,\n                    onCheckedChange = { onSettingsChange(settings.copy(samsungLogTransform = it)) },\n                    colors = SwitchDefaults.colors(\n                        checkedThumbColor = ResolveAmber,\n                        checkedTrackColor = Color(0xFF3E2D0F)\n                    ),\n                    modifier = Modifier.testTag(\"samsung_log_transform_switch\")\n                )\n            }\n\n            if (settings.samsungLogTransform) {\n                Spacer(modifier = Modifier.height(6.dp))\n                GradeSliderRow(\n                    label = \"Highlight Knee\",\n                    value = settings.samsungHighlightRollOff,\n                    onValueChange = { onSettingsChange(settings.copy(samsungHighlightRollOff = it)) },\n                    valueRange = 0.2f..1.0f,\n                    activeColor = ResolveAmber,\n                    testTag = \"highlight_knee_slider\"\n                )\n            }\n\n            HorizontalDivider(color = StudioCardBorder, modifier = Modifier.padding(vertical = 8.dp))\n\n            // Section 2: White Balance & Exposure\n            Text(\n                text = \"WHITE BALANCE & EXPOSURE\",\n                color = TextPrimary,\n                fontSize = 10.sp,\n                fontWeight = FontWeight.Bold,\n                letterSpacing = 0.5.sp\n            )\n            Spacer(modifier = Modifier.height(4.dp))\n\n            GradeSliderRow(\n                label = \"Temperature\",\n                value = settings.temperature,\n                onValueChange = { onSettingsChange(settings.copy(temperature = it)) },\n                valueRange = -1.0f..1.0f,\n                activeColor = Color(0xFFF59E0B),\n                formatString = \"%+.2f\",\n                testTag = \"temp_slider\"\n            )\n\n            GradeSliderRow(\n                label = \"Tint (G/M)\",\n                value = settings.tint,\n                onValueChange = { onSettingsChange(settings.copy(tint = it)) },\n                valueRange = -1.0f..1.0f,\n                activeColor = Color(0xFFEC4899),\n                formatString = \"%+.2f\",\n                testTag = \"tint_slider\"\n            )\n\n            GradeSliderRow(\n                label = \"Exposure EV\",\n                value = settings.exposure,\n                onValueChange = { onSettingsChange(settings.copy(exposure = it)) },\n                valueRange = -2.0f..2.0f,\n                activeColor = ResolveCyan,"
    num_lines: 248
