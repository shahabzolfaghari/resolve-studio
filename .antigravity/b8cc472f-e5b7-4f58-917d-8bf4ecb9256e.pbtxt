  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/components/VideoPlayerView.kt"
    end_line: 139
    content: "package com.example.ui.components\n\nimport android.graphics.Bitmap\nimport androidx.compose.foundation.Image\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.border\nimport androidx.compose.foundation.gestures.detectDragGestures\nimport androidx.compose.foundation.gestures.detectTapGestures\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.shape.CircleShape\nimport androidx.compose.foundation.shape.RoundedCornerShape\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.filled.*\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.*\nimport androidx.compose.ui.Alignment\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.draw.clip\nimport androidx.compose.ui.geometry.Offset\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.graphics.asImageBitmap\nimport androidx.compose.ui.input.pointer.pointerInput\nimport androidx.compose.ui.layout.ContentScale\nimport androidx.compose.ui.platform.testTag\nimport androidx.compose.ui.text.font.FontFamily\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport com.example.model.MaskType\nimport com.example.model.PowerWindowMask\nimport com.example.ui.theme.*\n\n@Composable\nfun VideoPlayerView(\n    gradedBitmap: Bitmap?,\n    rawBitmap: Bitmap?,\n    isPlaying: Boolean,\n    currentTimeMs: Long,\n    totalDurationMs: Long,\n    mask: PowerWindowMask,\n    showMaskGuide: Boolean,\n    onMaskChange: (PowerWindowMask) -> Unit,\n    onPlayPauseToggle: () -> Unit,\n    onSeek: (Float) -> Unit,\n    onStepFrame: (Int) -> Unit,\n    onBypassPress: (Boolean) -> Unit,\n    modifier: Modifier = Modifier\n) {\n    var splitPosition by remember { mutableStateOf<Float?>(null) } // null = full graded, 0..1 = split wipe\n\n    Card(\n        modifier = modifier\n            .testTag(\"video_player_viewport\")\n            .padding(4.dp),\n        colors = CardDefaults.cardColors(containerColor = StudioSurfaceVariant),\n        shape = RoundedCornerShape(12.dp)\n    ) {\n        Column(modifier = Modifier.padding(6.dp)) {\n            // Top overlay bar: Timecode, Wipe split toggle, and Hold to Bypass\n            Row(\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.SpaceBetween,\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .padding(horizontal = 6.dp, vertical = 2.dp)\n            ) {\n                // Timecode\n                Text(\n                    text = formatTimecode(currentTimeMs),\n                    color = ResolveAmber,\n                    fontSize = 11.sp,\n                    fontFamily = FontFamily.Monospace,\n                    fontWeight = FontWeight.Bold\n                )\n\n                Row(verticalAlignment = Alignment.CenterVertically) {\n                    // Split Wipe toggle\n                    IconButton(\n                        onClick = {\n                            splitPosition = if (splitPosition == null) 0.5f else null\n                        },\n                        modifier = Modifier.size(28.dp).testTag(\"split_wipe_toggle\")\n                    ) {\n                        Icon(\n                            imageVector = Icons.Default.Compare,\n                            contentDescription = \"Split Screen\",\n                            tint = if (splitPosition != null) ResolveAmber else TextMuted,\n                            modifier = Modifier.size(16.dp)\n                        )\n                    }\n\n                    Spacer(modifier = Modifier.width(6.dp))\n\n                    // Hold to Bypass Grade button\n                    Surface(\n                        modifier = Modifier\n                            .height(26.dp)\n                            .clip(RoundedCornerShape(6.dp))\n                            .pointerInput(Unit) {\n                                detectTapGestures(\n                                    onPress = {\n                                        onBypassPress(true)\n                                        tryAwaitRelease()\n                                        onBypassPress(false)\n                                    }\n                                )\n                            }\n                            .testTag(\"hold_to_bypass_button\"),\n                        color = Color(0xFF283142)\n                    ) {\n                        Row(\n                            verticalAlignment = Alignment.CenterVertically,\n                            modifier = Modifier.padding(horizontal = 8.dp)\n                        ) {\n                            Icon(Icons.Default.VisibilityOff, contentDescription = null, tint = TextSecondary, modifier = Modifier.size(12.dp))\n                            Spacer(modifier = Modifier.width(4.dp))\n                            Text(\"HOLD BYPASS\", color = TextSecondary, fontSize = 9.sp, fontWeight = FontWeight.Bold)\n                        }\n                    }\n                }\n            }\n\n            Spacer(modifier = Modifier.height(4.dp))\n\n            // Main Video Surface Box\n            Box(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .aspectRatio(16f / 9f)\n                    .clip(RoundedCornerShape(8.dp))\n                    .background(Color.Black)\n                    .border(1.dp, StudioCardBorder, RoundedCornerShape(8.dp)),\n                contentAlignment = Alignment.Center\n            ) {\n                // Render graded frame\n                gradedBitmap?.let { bmp ->\n                    Image(\n                        bitmap = bmp.asImageBitmap(),\n                        contentDescription = \"Graded Video Viewport\",\n                        contentScale = ContentScale.Fit,"
    num_lines: 259
