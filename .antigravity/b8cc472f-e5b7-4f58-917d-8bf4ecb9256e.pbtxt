      thinking_signature: "\022\240\n\n\235\n\001i\024}\023\237\254\234r\276+\021\357\244<\343\017\037\273\315\275\272t\211\324a\334\0348B\305V7\025\"\245\333\000L\2514S \301w\376\355\237\220\213\245\216\233)\022\357\243~\274v\036a\372\261\376G\211\005[\244\221\"\271\234\205=\016\353+UO3\227\365p*\232p\235D\325\\`\303\034/\'\305\264X\253\220\365uT\221#\244\031\307\327\004$\201\270}\276\022]1\255\236X\263\003Xs\355\237\200u3[\rz\351\360\017;\207|\352\na{c\204\375\253\aJ\276Sr\217V\264\376\227\265v\240C\252F\326_\332\304\025\336\036\303[\223\354\256r!N\267\313\217\270\022\f;P\205g\271\351w\320\264\230\354\025\\B\224\320!u\033\206\321\016D\334k\035\220\035\020\020\306\206\372\'\304\323\243\350\262\214\260i\037\2533\341\033\323\352\214\221\023\006\260#dC\310t\262\363\ar\3433\253\331\302\226\237\017\034l\370;-y8y\373\356\370B\342\272\020*DVK\330j\025\357wt\001~\300\003\0233\240\261C\225\345t\005\232e\263\236b\204\316*-\323:\222\350\026uO\020\315\307!\216]\372\032\000\370\016\336\270\031\210\305\aY\v\024\261L\361\224\357\356\343\222\350F\307s\214\327\367#\215fi\243\006\020\243F\264\306\243\220J\271\251i\206Nbq,\253\001h%\247\325vF\017\000\024\352\270\266\334U\210\374&\326A\340\371\036\367t\025\371\304Q[\'\360\243\224\200\363\326B\004\022@\326\302\347\236\267\243\367\300\313\372\303\240\306(\276\r\f\277\374\2645\020\227%\305#\355\260\306\214\206-{\222C\206 %\016\362p\204Q\242\320\327\022\244;J_;\3462d\216\356\243XI\354N\270\340\212x|1\311\267\001\033\032Z\340`\343Ec \256\200\316w3+\245Otw\275\205\257\230\3444\243GX\357!\211a\023Zf\217\301\341\251\276l\301\355\033\376\207\0315\254X4\220BA\260\'r\201\t\261n\b)\035\r4\271b\003\313\343\232\374\252E\024\224Dw2\345&\341\271\326\372\341\ag\367r85t/\362\204\213E\356)\327\2563\225U\273\213\231=-\362k\035\245d\372\002\307\267\344\006\211\330d^\200\257C\216\351\3618\201\373\177\270Ol\247\031m\342\036\302A*\006\341C\314\264\367\nCAL\243jO\a\366\177\030b\023\341\265\351&C\236\214\262\231l\v\342\334\365J\277\272g\016\257H\255:a*\346&\231\221~r\243\2078$A@\324\250\254.\f\"\266\241\031<\260\306\367\'\2452\234\275\n\340\001#E^\215s\f\n\251082@\222\326\244\371)8b\247\324{+Hd|,\273\234\377k\025\261S\241Y\227-\221b\345B\212k\231yPL\320\342\313\252\362E\377\277Bk\272\232\347\214\225Ry\334\363\371\250\271\214\262kC\272\370\220\275\t\335\232\267\\Uu$/\315Q\326\327\241\232b/\215^\301\356_\033\335c\v\314\236\303\272\337A\336|\372\233d\026r\032\305X4\360\261\343\220\367\003-r\367Nno\275\302j6T\214\361\260\002\304\336\241F\374O\030\306\367\214\245\257\240\334\a\"\255qZ/PPQ\v\243c?\322\246\222\b\000\374\204\\\336\344;\342\f\302H\321\005s\306$\313h\273\203a.\261\327\266FbS\215X\0273\370\354\026p66r\360\aG\367:\363\367\344\341\247e\301\314\a\234\204;(\223\221x\335\207\265\033=\362\332\200N\277\360$\222\017]2\302\234\354jB}\205\301f{\311\327yU\017~H\246\2277J\205\252\'X\242W`\334\252\266B`\245\315\253\000F\005\211\227\217Z\350\35537?]\303\201\336^\216\314\230 \242\325\246\371B\241\266\253i\327\235y\3765.+\321\341\256\0172;`/\033O\357\037\3273\0215\353\241\236\004L\345\036\256~\316*Z\214\2256a\367\274\250\363\2743\035$\342\213\202P\033\022\343\203D\354\322D\032w+\372~\000q\322S,\343\220\222g\237\r\025\2758\265\263\246\343XY\276\367\241G\207\203S\002\221\343\2271\330Y\212\356\330 %\247R\355\333\363o\323\350\204NKEbE\002N\251\265\255Wp3x\243M\200\350\033\003\326\371\032dz\371\0047\327\234\263\352\230)jHd\200-A8\343\207P\005S\232k\030\366\037\352FR\205[OT\263\334\336N3\000=\246\\I\345P\342\212\247\307\343\363> \200\342\270\307\316*\364MF\251\t\336C\235w@\331l2\021X\253\270\006\003N\207y8\226\234\270\212\303\a\322c\233O\316\345a!\230\2729\372\326e\357z\267\030\376\001\237\312^7;@\300P\221\0007\344\n\340\f\022\031\317K\226^\213&\361\327\251\3607\211,5K\030\325z-\223\321\264RyF\rh"
