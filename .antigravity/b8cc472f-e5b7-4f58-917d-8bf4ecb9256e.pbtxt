              text: "            // IRE Graticule Grid Lines (0%, 25%, 50%, 75%, 100%)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            for (fraction in floatArrayOf(0.25f, 0.5f, 0.75f)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val gx = fraction * w"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
