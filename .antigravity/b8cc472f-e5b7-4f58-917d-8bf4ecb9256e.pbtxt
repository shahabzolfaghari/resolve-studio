        target_content: "    fun exportVideo(onCompleted: (File) -> Unit) {\n        viewModelScope.launch {\n            _isExporting.value = true\n            _exportProgress.value = 0f\n            _exportStatusMessage.value = \"Encoding 4K Samsung Log video...\"\n\n            val base = _rawFrameBitmap.value ?: return@launch\n            val file = VideoExporter.renderGradedVideo(\n                context = getApplication(),\n                baseFrame = base,\n                settings = _gradeSettings.value,\n                durationSeconds = 6,\n                fps = 30,\n                onProgress = { p ->\n                    _exportProgress.value = p\n                    _exportStatusMessage.value = \"Rendering frame ${(p * 180).toInt()} of 180...\"\n                }\n            )\n\n            _exportProgress.value = 1.0f\n            _exportStatusMessage.value = \"Video export complete!\"\n            delay(400)\n            _isExporting.value = false\n            onCompleted(file)\n        }\n    }"
        replacement_content: "    fun exportVideo(\n        config: com.example.video.VideoExportConfig = com.example.video.VideoExportConfig(),\n        onCompleted: (File) -> Unit\n    ) {\n        viewModelScope.launch {\n            _isExporting.value = true\n            _exportProgress.value = 0f\n            _exportStatusMessage.value = \"Encoding ${config.aspectRatio.shortName} at ${config.quality.bitrateBps / 1_000_000} Mbps...\"\n\n            val base = _rawFrameBitmap.value ?: return@launch\n            val file = VideoExporter.renderGradedVideo(\n                context = getApplication(),\n                baseFrame = base,\n                settings = _gradeSettings.value,\n                config = config,\n                onProgress = { p ->\n                    _exportProgress.value = p\n                    val totalFrames = config.durationSeconds * config.fps\n                    val frameNum = (p * totalFrames).toInt()\n                    _exportStatusMessage.value = \"Rendering frame $frameNum of $totalFrames (${(p * 100).toInt()}%)...\"\n                }\n            )\n\n            _exportProgress.value = 1.0f\n            _exportStatusMessage.value = \"Video export complete!\"\n            delay(400)\n            _isExporting.value = false\n            onCompleted(file)\n        }\n    }"
