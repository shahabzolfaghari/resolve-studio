  code_action {
    action_spec {
      create_file {
        instruction: "package com.example.ui.components\n\nimport androidx.compose.foundation.Canvas\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.gestures.detectDragGestures\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.shape.RoundedCornerShape\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.filled.Flip\nimport androidx.compose.material.icons.filled.Layers\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.*\nimport androidx.compose.ui.Alignment\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.draw.clip\nimport androidx.compose.ui.geometry.Offset\nimport androidx.compose.ui.geometry.Size\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.graphics.PathEffect\nimport androidx.compose.ui.graphics.drawscope.Stroke\nimport androidx.compose.ui.input.pointer.pointerInput\nimport androidx.compose.ui.platform.testTag\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport com.example.model.MaskType\nimport com.example.model.PowerWindowMask\nimport com.example.ui.theme.*\n\n@Composable\nfun PowerWindowControls(\n    mask: PowerWindowMask,\n    onMaskChange: (PowerWindowMask) -> Unit,\n    modifier: Modifier = Modifier\n) {\n    Card(\n        modifier = modifier\n            .testTag(\"power_window_controls\")\n            .padding(4.dp),\n        colors = CardDefaults.cardColors(containerColor = StudioSurfaceVariant),\n        shape = RoundedCornerShape(12.dp)\n    ) {\n        Column(modifier = Modifier.padding(10.dp)) {\n            // Header Row: Mask Type & Invert\n            Row(\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.SpaceBetween,\n                modifier = Modifier.fillMaxWidth()\n            ) {\n                Row(verticalAlignment = Alignment.CenterVertically) {\n                    Icon(\n                        imageVector = Icons.Default.Layers,\n                        contentDescription = \"Mask\",\n                        tint = ResolveAmber,\n                        modifier = Modifier.size(16.dp)\n                    )\n                    Spacer(modifier = Modifier.width(6.dp))\n                    Text(\n                        text = \"POWER WINDOW MASK\",\n                        color = TextPrimary,\n                        fontSize = 11.sp,\n                        fontWeight = FontWeight.Bold,\n                        letterSpacing = 1.sp\n                    )\n                }\n\n                // Invert Button\n                FilterChip(\n                    selected = mask.invert,\n                    onClick = { onMaskChange(mask.copy(invert = !mask.invert)) },\n                    label = { Text(\"Invert\", fontSize = 10.sp) },\n                    leadingIcon = {\n                        Icon(Icons.Default.Flip, contentDescription = \"Invert\", modifier = Modifier.size(12.dp))\n                    },\n                    modifier = Modifier.height(28.dp).testTag(\"invert_mask_toggle\")\n                )\n            }\n\n            Spacer(modifier = Modifier.height(8.dp))\n\n            // Mask Shape Selector Tabs\n            Row(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .clip(RoundedCornerShape(8.dp))\n                    .background(Color(0xFF10131B))\n                    .padding(2.dp),\n                horizontalArrangement = Arrangement.SpaceEvenly\n            ) {\n                MaskType.values().forEach { type ->\n                    val isSelected = mask.type == type\n                    Surface(\n                        onClick = { onMaskChange(mask.copy(type = type)) },\n                        color = if (isSelected) ResolveAmber.copy(alpha = 0.2f) else Color.Transparent,\n                        shape = RoundedCornerShape(6.dp),\n                        modifier = Modifier.weight(1f).testTag(\"mask_type_${type.name.lowercase()}\")\n                    ) {\n                        Text(\n                            text = when (type) {\n                                MaskType.NONE -> \"Off\"\n                                MaskType.RADIAL -> \"Radial / Oval\"\n                                MaskType.LINEAR -> \"Linear Grad\"\n                            },\n                            color = if (isSelected) ResolveAmber else TextSecondary,\n                            fontSize = 10.sp,\n                            fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal,\n                            modifier = Modifier.padding(vertical = 6.dp),\n                            textAlign = androidx.compose.ui.text.style.TextAlign.Center\n                        )\n                    }\n                }\n            }\n\n            if (mask.type != MaskType.NONE) {\n                Spacer(modifier = Modifier.height(8.dp))\n\n                // Radius / Size Slider\n                Row(\n                    verticalAlignment = Alignment.CenterVertically,\n                    modifier = Modifier.fillMaxWidth()\n                ) {\n                    Text(\"Size\", color = TextSecondary, fontSize = 10.sp, modifier = Modifier.width(50.dp))\n                    Slider(\n                        value = mask.radiusX,\n                        onValueChange = { onMaskChange(mask.copy(radiusX = it, radiusY = it)) },\n                        valueRange = 0.1f..0.8f,\n                        colors = SliderDefaults.colors(thumbColor = ResolveAmber, activeTrackColor = ResolveAmber),\n                        modifier = Modifier.weight(1f).testTag(\"mask_size_slider\")\n                    )\n                    Text(String.format(\"%.2f\", mask.radiusX), color = TextPrimary, fontSize = 10.sp, modifier = Modifier.width(36.dp))\n                }\n\n                // Feather Slider\n                Row(\n                    verticalAlignment = Alignment.CenterVertically,\n                    modifier = Modifier.fillMaxWidth()\n                ) {\n                    Text(\"Feather\", color = TextSecondary, fontSize = 10.sp, modifier = Modifier.width(50.dp))\n                    Slider(\n                        value = mask.feather,\n                        onValueChange = { onMaskChange(mask.copy(feather = it)) },\n                        valueRange = 0.05f..0.6f,\n                        colors = SliderDefaults.colors(thumbColor = ResolveCyan, activeTrackColor = ResolveCyan),\n                        modifier = Modifier.weight(1f).testTag(\"mask_feather_slider\")\n                    )\n                    Text(String.format(\"%.2f\", mask.feather), color = TextPrimary, fontSize = 10.sp, modifier = Modifier.width(36.dp))\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun PowerWindowVisualGuide(\n    mask: PowerWindowMask,\n    onMaskChange: (PowerWindowMask) -> Unit,\n    modifier: Modifier = Modifier\n) {\n    if (mask.type == MaskType.NONE) return\n\n    Box(\n        modifier = modifier\n            .fillMaxSize()\n            .pointerInput(mask) {\n                detectDragGestures { change, dragAmount ->\n                    change.consume()\n                    val dx = dragAmount.x / size.width\n                    val dy = dragAmount.y / size.height\n                    val newCx = (mask.centerX + dx).coerceIn(0.05f, 0.95f)\n                    val newCy = (mask.centerY + dy).coerceIn(0.05f, 0.95f)\n                    onMaskChange(mask.copy(centerX = newCx, centerY = newCy))\n                }\n            }\n    ) {\n        Canvas(modifier = Modifier.fillMaxSize()) {\n            val w = size.width\n            val h = size.height\n            val cx = mask.centerX * w\n            val cy = mask.centerY * h\n\n            when (mask.type) {\n                MaskType.RADIAL -> {\n                    val rx = mask.radiusX * w\n                    val ry = mask.radiusY * h\n\n                    // Main mask boundary ellipse\n                    drawOval(\n                        color = ResolveAmber,\n                        topLeft = Offset(cx - rx, cy - ry),\n                        size = Size(rx * 2f, ry * 2f),\n                        style = Stroke(width = 1.5.dp.toPx())\n                    )\n\n                    // Feather boundary (dashed)\n                    val featherRx = rx * (1f + mask.feather)\n                    val featherRy = ry * (1f + mask.feather)\n                    drawOval(\n                        color = ResolveCyan.copy(alpha = 0.6f),\n                        topLeft = Offset(cx - featherRx, cy - featherRy),\n                        size = Size(featherRx * 2f, featherRy * 2f),\n                        style = Stroke(\n                            width = 1.dp.toPx(),\n                            pathEffect = PathEffect.dashPathEffect(floatArrayOf(6f, 6f))\n                        )\n                    )\n\n                    // Center reticle\n                    drawCircle(color = ResolveAmber, radius = 4.dp.toPx(), center = Offset(cx, cy))\n                }\n                MaskType.LINEAR -> {\n                    val lineY = cy\n                    val featherDist = mask.radiusY * h * mask.feather\n\n                    // Center line\n                    drawLine(\n                        color = ResolveAmber,\n                        start = Offset(0f, lineY),\n                        end = Offset(w, lineY),\n                        strokeWidth = 2.dp.toPx()\n                    )\n                    // Feather lines\n                    drawLine(\n                        color = ResolveCyan.copy(alpha = 0.5f),\n                        start = Offset(0f, lineY - featherDist),\n                        end = Offset(w, lineY - featherDist),\n                        strokeWidth = 1.dp.toPx(),\n                        pathEffect = PathEffect.dashPathEffect(floatArrayOf(6f, 6f))\n                    )\n                    drawLine(\n                        color = ResolveCyan.copy(alpha = 0.5f),\n                        start = Offset(0f, lineY + featherDist),\n                        end = Offset(w, lineY + featherDist),\n                        strokeWidth = 1.dp.toPx(),\n                        pathEffect = PathEffect.dashPathEffect(floatArrayOf(6f, 6f))\n                    )\n                }\n                MaskType.NONE -> {}\n            }\n        }\n    }\n}\n"
        path {
          absolute_uri: "file:///app/src/main/java/com/example/ui/components/PowerWindowOverlay.kt"
        }
        overwrite: true
      }
    }
