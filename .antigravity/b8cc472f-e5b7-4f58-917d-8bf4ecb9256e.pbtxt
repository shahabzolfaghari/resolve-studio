      thinking_signature: "\022\253\027\n\250\027\001i\024}\023\225+\ax{\0230\3119\315\335\225Z\313\262\'\035\037\350NX\027\220\256R\346\356\003\215>\371\244h:o 3P\240\000\237\026\342q\375\244\371\311\331\305\300L\220\345\357\221\211\344\221\201)\'\vd\242\024O\362-\'\326\301W\240)\210U\376\2109q\306\'\263ah$,\371q\370\205\0336<~\370\220\357\333\003\001$\235\312\223\370\321~\205.\tc\310\252m0e \370\376p\332r4N\205\020\030\252\347\273w\347\324\231\035!\254\006u\241x~\b1\a^\004\346\222\316\201\372x=\022Y\257\3220\315\273\323M\262\034\300\324r\342G\273\334\b\257\300\024\272\265\222x2\v\237KC^\v)\355\361|<\313\031!\357\3738?5Z\313\036\030\3058XN\363\324\300R\340\213\360kF(\342\251\360\211\020\327\263\235=z\362\233\3147\357\352\036\364\234\260M\344\006;\351\375.DAft\0310\332\3478\207\372\276\340~\322\301f\215\n\035\230V3\224(X\253\022\"\021/\330\2325\2074\345RT\256?\016\370\177\323\207\277\266`_\231__\365Z\004\311t\252\344~5\263.\222\362\224%\000\202\374\352bG\351eq0\335\f\240j)D\302\242\"\302\322\262\255dp(\030\310$\337\312\203\316^\260\240\370\315$\221\306\265\353\265\205\301\252&\001\363\254\251\311s\201\304X\0040r\312\214\225\313\223\360\025b\252\270\327T\022\2467\367\020(r\377\271\354]\3358\302\r\332\233R\300\353i\237\205\275c\035\bV%\346S\311\r\207\r\316\226\'+\377\r\202\031\231\277\247\326\361>\246\000\303<S\261\270Z\005\251\000\217F\354x\354l\023\265\214\361\236\273m\373\250\202\350^\225\002\3425\005\026\252\306bK\022\222\266\304\031\373\2623|\376\303q\246\343\241\357yudA\227\260\255\257\215V\v:9\305\207YYo\371\230\365w\242Y@\rZV\254:\001\341:\020?_\237\366\343\261\244q\277\377\232\366\tm\240\240\006\225\367\034\344h_\332\016\\\303%\270f\325\001J\244\'\\\2275\232\3409\214\364\240\316\004\f\2427\310\036\304K^^\317n\266\337.\005\272\327\215=qv\275\243g+7\235\314\226?\254\252\322\035\206,\305\263y\357Zm\313\'\323]\036\226\261q\216H\371\347g\266\315\345*j7v\217\242\304\032\335J\373Km\3417xW\377)\t\325\210N|\341\335\335\374\205\nnQ\aU\331\234\244O\205\222\352\365\212\3