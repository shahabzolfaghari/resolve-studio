  code_action {
    action_spec {
      create_file {
        instruction: "package com.example.ui.components\n\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.shape.RoundedCornerShape\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.filled.*\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.*\nimport androidx.compose.ui.Alignment\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.draw.clip\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.graphics.vector.ImageVector\nimport androidx.compose.ui.platform.testTag\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport com.example.ui.theme.*\n\n@Composable\nfun ExportDialog(\n    isExporting: Boolean,\n    exportProgress: Float,\n    statusMessage: String,\n    onDismiss: () -> Unit,\n    onExportVideo: () -> Unit,\n    onExportStill: () -> Unit,\n    onExportCubeLut: () -> Unit\n) {\n    AlertDialog(\n        onDismissRequest = { if (!isExporting) onDismiss() },\n        containerColor = StudioSurface,\n        title = {\n            Row(verticalAlignment = Alignment.CenterVertically) {\n                Icon(Icons.Default.MovieFilter, contentDescription = null, tint = ResolveAmber, modifier = Modifier.size(20.dp))\n                Spacer(modifier = Modifier.width(8.dp))\n                Text(\"EXPORT COLOR GRADE\", color = TextPrimary, fontSize = 14.sp, fontWeight = FontWeight.Bold)\n            }\n        },\n        text = {\n            Column(modifier = Modifier.fillMaxWidth()) {\n                if (isExporting) {\n                    Column(\n                        horizontalAlignment = Alignment.CenterHorizontally,\n                        modifier = Modifier.fillMaxWidth().padding(vertical = 16.dp)\n                    ) {\n                        CircularProgressIndicator(\n                            progress = { exportProgress },\n                            color = ResolveAmber,\n                            trackColor = Color(0xFF283142),\n                            modifier = Modifier.size(54.dp)\n                        )\n                        Spacer(modifier = Modifier.height(14.dp))\n                        Text(\n                            text = \"${(exportProgress * 100).toInt()}%\",\n                            color = ResolveAmber,\n                            fontSize = 18.sp,\n                            fontWeight = FontWeight.Bold\n                        )\n                        Spacer(modifier = Modifier.height(4.dp))\n                        Text(\n                            text = statusMessage,\n                            color = TextSecondary,\n                            fontSize = 12.sp\n                        )\n                    }\n                } else {\n                    Text(\n                        text = \"Choose your delivery format. ResolveStudio renders with full 10-bit Samsung Log precision:\",\n                        color = TextSecondary,\n                        fontSize = 12.sp,\n                        lineHeight = 16.sp\n                    )\n                    Spacer(modifier = Modifier.height(16.dp))\n\n                    ExportOptionCard(\n                        icon = Icons.Default.Videocam,\n                        title = \"Render Master MP4 Video\",\n                        subtitle = \"High-bitrate H.264/HEVC 4K color-graded video\",\n                        accentColor = ResolveAmber,\n                        onClick = onExportVideo,\n                        testTag = \"export_option_video\"\n                    )\n\n                    Spacer(modifier = Modifier.height(10.dp))\n\n                    ExportOptionCard(\n                        icon = Icons.Default.Image,\n                        title = \"Export Graded Still (PNG)\",\n                        subtitle = \"Pristine uncompressed frame for grading review\",\n                        accentColor = ResolveCyan,\n                        onClick = onExportStill,\n                        testTag = \"export_option_still\"\n                    )\n\n                    Spacer(modifier = Modifier.height(10.dp))\n\n                    ExportOptionCard(\n                        icon = Icons.Default.Save,\n                        title = \"Export .cube 3D LUT\",\n                        subtitle = \"DaVinci Resolve / Premiere Pro desktop compatible 33x33x33 LUT\",\n                        accentColor = ResolveGreen,\n                        onClick = onExportCubeLut,\n                        testTag = \"export_option_cube\"\n                    )\n                }\n            }\n        },\n        confirmButton = {\n            if (!isExporting) {\n                TextButton(onClick = onDismiss, modifier = Modifier.testTag(\"close_export_dialog\")) {\n                    Text(\"Cancel\", color = TextMuted)\n                }\n            }\n        }\n    )\n}\n\n@Composable\nfun ExportOptionCard(\n    icon: ImageVector,\n    title: String,\n    subtitle: String,\n    accentColor: Color,\n    onClick: () -> Unit,\n    testTag: String\n) {\n    Surface(\n        onClick = onClick,\n        color = StudioSurfaceVariant,\n        shape = RoundedCornerShape(10.dp),\n        modifier = Modifier.fillMaxWidth().testTag(testTag)\n    ) {\n        Row(\n            verticalAlignment = Alignment.CenterVertically,\n            modifier = Modifier.padding(12.dp)\n        ) {\n            Box(\n                modifier = Modifier\n                    .size(36.dp)\n                    .clip(RoundedCornerShape(8.dp))\n                    .background(accentColor.copy(alpha = 0.15f)),\n                contentAlignment = Alignment.Center\n            ) {\n                Icon(icon, contentDescription = null, tint = accentColor, modifier = Modifier.size(20.dp))\n            }\n\n            Spacer(modifier = Modifier.width(12.dp))\n\n            Column(modifier = Modifier.weight(1f)) {\n                Text(text = title, color = TextPrimary, fontSize = 12.sp, fontWeight = FontWeight.Bold)\n                Spacer(modifier = Modifier.height(2.dp))\n                Text(text = subtitle, color = TextMuted, fontSize = 10.sp, lineHeight = 13.sp)\n            }\n\n            Icon(Icons.Default.ChevronRight, contentDescription = null, tint = TextMuted, modifier = Modifier.size(18.dp))\n        }\n    }\n}\n"
        path {
          absolute_uri: "file:///app/src/main/java/com/example/ui/components/ExportDialog.kt"
        }
        overwrite: true
      }
    }
