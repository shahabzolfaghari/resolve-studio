            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        return HistogramData(rBins, gBins, bBins, lumBins)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                totalSamples++"
