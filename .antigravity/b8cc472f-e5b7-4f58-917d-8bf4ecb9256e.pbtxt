              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        ) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            Text(\"LUM\", color = TextMuted, fontSize = 8.sp, fontWeight = FontWeight.Bold)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            modifier = Modifier"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
