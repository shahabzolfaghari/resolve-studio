              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Text(\"LUM MASTER\", color = TextMuted, fontSize = 7.5.sp, fontWeight = FontWeight.Bold)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Text("
