            lines {
              text: "            // =========================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // 2. THE INTERACTIVE COLOR WHEEL CANVAS"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Provides Hue spectrum, saturation vector line, and reticle"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // =========================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Box("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                contentAlignment = Alignment.Center,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                modifier = Modifier"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    .size(118.dp)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    .size(wheelDiameter)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .pointerInput(Unit) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        detectTapGestures("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            onDoubleTap = {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                onValueChange(value.copy(x = 0f, y = 0f))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    .pointerInput(Unit) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    .pointerInput(isPrecisionFineTune, value) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        detectDragGestures { change, dragAmount ->"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            change.consume()"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            val sensitivity = 0.015f"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                            // High-bitrate precision sensitivity: 0.005f vs normal 0.015f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val sensitivity = if (isPrecisionFineTune) 0.004f else role.defaultSensitivity"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val newX = (value.x + dragAmount.x * sensitivity).coerceIn(-1f, 1f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            val newY = (value.y - dragAmount.y * sensitivity).coerceIn(-1f, 1f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            // Constrain inside unit circle"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val dist = sqrt(newX * newX + newY * newY)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            if (dist > 1f) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                onValueChange(value.copy(x = newX / dist, y = newY / dist))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                onValueChange(value.copy(x = newX, y = newY))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                Canvas(modifier = Modifier.fillMaxSize()) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    val radius = size.minDimension / 2f - 6.dp.toPx()"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    val center = Offset(size.width / 2f, size.height / 2f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    // Draw outer subtle dark background"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    drawCircle("
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                        color = Color(0xFF141720),"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                        radius = radius,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                        center = center"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    )"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    // Draw color spectrum border ring (Red -> Yellow -> Green -> Cyan -> Blue -> Magenta -> Red)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    // 1. Dark Neutral Studio Base"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    drawCircle("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        color = Color(0xFF11141B),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        radius = radius,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        center = center"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 2. Concentric Saturation Reference Graticules (25%, 50%, 75% Saturation)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val satRings = floatArrayOf(0.25f, 0.50f, 0.75f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    for (satFrac in satRings) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        drawCircle("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = Color(0xFF222B3B),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            radius = radius * satFrac,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            center = center,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            style = Stroke("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                width = 0.8.dp.toPx(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                pathEffect = PathEffect.dashPathEffect(floatArrayOf(3f, 5f))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 3. 360-degree Color Spectrum Outer Ring"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // Spectrum: Red -> Yellow -> Green -> Cyan -> Blue -> Magenta -> Red"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val spectrumSweep = Brush.sweepGradient("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        colors = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            Color(0xFFEF4444), // Red"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                            Color(0xFFFBBF24), // Yellow"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                            Color(0xFF10B981), // Green"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                            Color(0xFF06B6D4), // Cyan"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                            Color(0xFF3B82F6), // Blue"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
