            }
            lines {
              text: "- **Workspace Layout**: DaVinci Resolve dark studio dock with dedicated scopes monitor, primary color wheels (Lift/Gamma/Gain/Offset), RGB/Hue curve editor, power window masking, and effects rack."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Color Space & Input Profile**: Native **Samsung Log** (logarithmic gamma curve optimized for 10-bit HEVC Pro Video) with mathematical Rec.709 Color Space Transform (CST), dynamic range expansion, highlight knee roll-off, and bundled official Samsung conversion profiles."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Privacy & Storage Model**: Zero-permission Android Photo Picker for importing camera roll videos; standard scoped storage for exporting rendered MP4s, graded frames, and `.cube` LUT files with native Android system share sheet."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 1. Overview & Core Concept"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### What It Does"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ResolveStudio brings the precision and workflow of DaVinci Resolve\'s color grading suite to Android smartphones and tablets. It allows videographers and content creators who shoot 4K 10-bit Log footage on the Samsung Galaxy S24 Ultra (and other modern cameras) to preview, correct, grade, and export their footage directly on their device with zero quality degradation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Target Audience & Persona"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "Mobile filmmakers, content creators, cinematographers, and colorists using Samsung Galaxy S24 Ultra Pro Video mode who need an on-device color grading suite that matches desktop NLE precision rather than relying on basic social media filters."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Key Value"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **True Samsung Log Color Pipeline**: Accurately decompresses Samsung Log gamma and converts to Rec.709 with highlight retention, eliminating muddy midtones and clipped highlights."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **DaVinci Resolve Tactile Feel**: Familiar dark studio interface with real-time responsive color wheels, spline curves, and live broadcast scopes."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Multi-Format Output**: Export high-bitrate graded MP4 videos, frame stills, or `.cube` 3D LUTs to bring into desktop editing workflows."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 2. User Experience & Visual Design"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Key User Flows"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "[Import Clip] \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\226\272 [Color Space Setup] \342\224\200\342\224\200\342\224\200\342\226\272 [Primary Correction]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " (Photo Picker /         (Samsung Log -> Rec.709  (Lift / Gamma / Gain"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  Sample S24 Log)         Highlight Roll-Off)      Color Wheels & Scopes)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                                          \342\224\202"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                                          \342\226\274"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "[Export Result] \342\227\204\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200 [Effects & Masking] \342\227\204\342\224\200\342\224\200\342\224\200 [Curves & Qualifiers]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " (Render MP4, LUT        (Power Windows, Grain,   (RGB Curves, Hue vs Hue,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  or PNG Still)           Halation, Vignette)      Hue vs Sat, Hue vs Lum)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Clip Loading**: Open video via system Photo Picker or test instantly with bundled realistic Samsung S24 Ultra Log 4K footage."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Setup & CST**: Toggle input profile (Samsung Log, Flat Pro Video, Standard Rec.709) with automated tone mapping and highlight knee recovery."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Primary Grading**: Touch and drag Lift, Gamma, Gain, and Offset color wheels with master wheel luminance sliders; monitor changes in real time on the Waveform Parade and Vectorscope."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Curves & Secondary Grading**: Fine-tune custom spline curves (Master, Red, Green, Blue) and Hue curves (Hue vs Sat, Hue vs Hue, Hue vs Lum)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Power Windows & Masking**: Add circular or linear gradient masks with feathering to selectively illuminate subjects or apply vignettes."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **Film Look**: Dial in analog film grain, halation warm bloom, and highlight glow."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "7. **Bypass / Split-Screen Comparison**: Press and hold to instantly compare the raw Samsung Log flat profile against the graded look."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "8. **Export**: Render out full-resolution MP4 video, save a pristine 4K PNG still, or export a 33x33x33 `.cube` LUT to transfer to desktop."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Visual Identity & Theme"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Studio Dark Aesthetic**: Professional dark palette (`#0E1116` charcoal background, `#1A1E26` dock surface, `#252B36` tool panels) modeled after color grading suites to maintain neutral eye adaptation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Resolve Accents**: Precision color rings (Cyan/Red, Magenta/Green, Yellow/Blue axes), golden amber playheads (`#F59E0B`), and crisp cyan indicators (`#06B6D4`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Typography**: Clean, monospace numeric readouts (`sp` scaled) for RGB balance, kelvin temperature, tint, lift, gamma, gain, and timecode values."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Tactile Touch Wheels**: Custom vector-drawn touch controls with central reticle, coordinate readouts, reset double-tap, and fine-tune sensitivity."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 3. Key Product Decisions & Trade-Offs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Decision 1: High-Performance Color Pipeline"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Chosen Approach**: Hardware-accelerated OpenGL ES / RenderScript color math engine utilizing multi-pass fragment shaders and LUT texture sampling for real-time 60fps playback, paired with Android MediaCodec and MediaMuxer for full MP4 video encoding."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Why**: Color grading 4K video requires sub-16ms latency during playback and scrubber movement. Software-only pixel processing is too slow for 4K."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Alternatives Considered**: Web-view based grading (far too slow for 4K video) or static frame-only processing (doesn\'t meet user\'s explicit request for full video export)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Decision 2: Samsung Log Mathematical Transform"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Chosen Approach**: Built-in Samsung Log EOTF/OETF logarithmic equations combined with bundled official Samsung 3D LUTs and custom matrix conversions for Rec.709 / BT.2020."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Why**: S24 Ultra Pro Video records in 10-bit HEVC with Samsung\'s proprietary logarithmic curve; mathematically unwrapping it recovers up to 13 stops of dynamic range without clipping highlights."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Decision 3: Precision Scopes Engine"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Chosen Approach**: Real-time GPU/CPU histogram and RGB waveform calculation that samples the graded video surface at 30fps and renders vectorscope color phase circles with target skin-tone line."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Why**: True colorists rely on scopes rather than uncalibrated phone displays to ensure legal broadcast limits and neutral skin tones."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 4. Technical Architecture & Component Hierarchy"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
