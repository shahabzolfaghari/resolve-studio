      thinking_signature: "\022\257\r\n\254\r\001i\024}\023\222Hv \355\036\203%?\020\016H\212\320\0319\361\362n\241\216i\222k\3425b\330\320\372wM\242\2422\340R\364\204\v0B\360\024\2354\277P2\272\270\277\255\222\016\261\312@h\27196\3417\347u\276\3546\224\261$\360\245\016t\027f\2516\034\317\274+\276\030\336\264\256@j\202q\352\000\037\301\b\325~\216\224a\353~0\r\260\021\304\343\364c\362w\220\207\032\326\201nb=X\204\303\213\201\365\375\351(;\\\030\257L\371\265K\227\371R\'\356z\262\270\031\022e3\020HX\312*G\367^\316\354Qa\366,\004^0\025\345\350.\252\260*Z\2045\357\246\361z\3128\213\340-V\233\374\001\326\315\340\334\373Q\351\r\270#Ia\0169\260s\026\263\211\255sZgd\372\371\213{\020\026\200\325\374\207\310\fK\032P=\275\t\322\257\306gu]\325l\356\362\244s\243\341T8\351c\177\357\037\r\330\323\362\217\371XF\315\214P\333\223n\232$oyL\314\271_(9\266\034n\231\210\022\326\264\252hp5Gn6\201<\233a\347\027\2549\f\265\260\342E\251\3741\201\326\376\272h\317\017P\224\256\326\357\273\000\300\211\366\202\261_\320\266\366\370\307\352\365O\245\267\320\006\2546\036kv\374\332=V!i\307`X\271>))\250\035@r\323\324Dd\240\355F\335\314^S\274Q~\2133#\275\"\245\227\006=\255\301,\n\343\332Oc\330vd\001\344\274\223\342\252\032!\310\204\202\r\302\322\315\260\003\024\004 \367\177\377a\255(V\364\354\227\2770A\321\034?\002\242\025CJv\311wc.\203\240>:\236ex5\307\264x<\226q\'\336\017k\253t\316\260\320Y\334\232y\204\255\237\332\331Z\030_\241z\351Q~\302\266{\376\3669\336,\263\222a\035\213\312\b\334\336\325\252\'F\003/^\342\353\350A\031\350\306\345\031\033\3044\325\240\277eS\222\322\025\bn\260\312\252V\354\337k\024\243\271\307\254,\035\264\317\234\036v\324\325\246\031\345P\357\232k\277\237\213\333\037\367\372_\032\rHl\310g/h5\035Y\302\305\301\311\353\000\265\303@\200\362\373!\306h\374k\377w\3706\345\232\301\337\360\235q\377\244\346:mdL9\212Du\\\300g\263B\314\330\277\212\223Y\210\317\306j\2734m\256\241fQ\035\250\030\003\235\242?\tck\204\"\240\207\314\b\340\340\213\273u y\205\216X\0334V\346\032\255M\327R+k\220\312\262\265gkc\021\017f\222u\216\243\037\342\210\0169\365\207\366\257\337\333\022\307GP\271c\324Y-\030@\242@\257m\032Oc\236\020q\"e\232\331-i\260\006\037\314KG\003\202\f\233\264`\a\35253S\311\201!E\361\027\275\342\a\273\371I6\035r\272\367\370,\000{4\367\346l\266\004$M\f\345U\222~\364\232\035\303\334)\203R\305\267\246\262S\266\250]<\023\311\200\342N\231\346B\247E=af{\221\205\307\356*\262\234h\274)Es\031b=\355\001u\214,\310\275\026\325\026JC\370n#\240fOfg\246(\002\315\357\333ty\241:\323\236\227\245\307,\236\216\330k\266/\274\0373\033\3463A\240\321\323K\374g/\255\376G\344$\220\356]\254s\226^\227\030r\237\355\247\016\027\347\263wz=v\373f\340[\023\215r\237\b\276x\215[/+J\326\224\254\257\333\032\257\365\273\371\236\363\273\266\302e\245\277\366\373O\242@\n{\223>\3244\254G\235\365b\217_\033r\217\315\244|@\270\002\303C_!\273)\310C\365\330\257!>S\001L\033/\237\')CI\356r\303g\340\216wo\n<\t\0270\000\353T\a\031\375\311\r\017\236\363\002 \034\377\224\233 \030\316\251\260HH\333\375\245\273\323\263\020\302Pc7\026<\344\3274b\242\206\234\216\351\367\263n\303\315H\214\271\345\021\a\027l\231\321\362|5u\226<a~\2543 aK\\\033\272\300\036w\257\374\223\230\312\235%(\353\037=)u\311\037\030\300s\037\262p\341\035\006\334p7\375u\254\021\000\035\246\203\334%l^\261\377\262y\311T.z\361/\351=\277a\362\253\2275a\003\261\n%\245\243\266\324\255\333\354\352}\372+\271\022\t\341\331\343\242\300\203\254\233\023\304\211\337\fs\003@\335\244<\n\242\215\377\227v\337\201\210=S}\231\341S\020\366H\f>\370\251?&ac.\017\337h\236\262\211\360\240\236p\v\n \202Q\374\022{\003Z\024\rM/\223}Z\351\254\237Ze\025\230\3315Q|\227\023\232\177\tvs\353|y\355\024\346\215=\216\375\361\'I\360\354\036u\312\021\254\334\334{\207\177\316\031os\341R+\025\210,.\322i\037@\350\032\350L \352:;\277\260\211A\274\213\031\265:\367l\226\321\314i\301i\303\370\234\250\325\005\032\221D\366\257\023\v\024Cpt\245-\260\231\210\233\030\300\"\271\257\336\207[!&?i\316\265<9\375\247\311\256\263g\a\3155\255\302\bP\363\324E\351x\332\263\274\036\242\250\322\037r\017\302\325\232{X\206\361\360\265\310@\226iL&\307Z\371m}}\372\340\235jix9XS\3071\320\303:v[\361x\203\b\004\027\3718\324)\376\221;_\222\032Zn@\033\365\343\3126{\361\270\370\221\206\202\237\207\223\303WFP\266\023\247a\276\220\324\232\332a\212HF\212e\202WO\217`\362\223\022\362\326\374^\350\304\026X\242\374\313\b\321\314\361t*\242\272\372\206zz\231\024O\247\r\025>`\004\001 \222\374\213\230\202\301\301\\?\r\372\261\237Q3\275\217\215}\267\t\363YF@(\325\260\b\351)@\246\314\374\r\031AG\342\233\027\220\251t\340\234\314T-\277\223\375\352\032\003S4\217\245\025n\"O<\365\006\\\262\226\306\307\224Yh\250\311\264\220\247\347\245\376\361^\364\324fa2N\235\242\320i\016\002VBkV\277BY\002@Z\326\215\027\302\266\274a\352\343G\037\177\235\207^\346\340\325-\0226\001d;\313\033\211\377\277\360\345\017i&lI.\027[Z\322L\316\327\353\276Hv\340Wa]\026\360z%\031\306\246GR\225 \243\0041\310\244P\226\253\217\350\332\240MG\305R\206\211("
