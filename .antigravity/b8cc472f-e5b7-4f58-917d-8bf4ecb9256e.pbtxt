  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/components/VideoPlayerView.kt"
    start_line: 99
    end_line: 199
    content: "                                detectTapGestures(\n                                    onPress = {\n                                        onBypassPress(true)\n                                        tryAwaitRelease()\n                                        onBypassPress(false)\n                                    }\n                                )\n                            }\n                            .testTag(\"hold_to_bypass_button\"),\n                        color = Color(0xFF283142)\n                    ) {\n                        Row(\n                            verticalAlignment = Alignment.CenterVertically,\n                            modifier = Modifier.padding(horizontal = 8.dp)\n                        ) {\n                            Icon(Icons.Default.VisibilityOff, contentDescription = null, tint = TextSecondary, modifier = Modifier.size(12.dp))\n                            Spacer(modifier = Modifier.width(4.dp))\n                            Text(\"HOLD BYPASS\", color = TextSecondary, fontSize = 9.sp, fontWeight = FontWeight.Bold)\n                        }\n                    }\n                }\n            }\n\n            Spacer(modifier = Modifier.height(4.dp))\n\n            // Main Video Surface Box\n            Box(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .aspectRatio(16f / 9f)\n                    .clip(RoundedCornerShape(8.dp))\n                    .background(Color.Black)\n                    .border(1.dp, StudioCardBorder, RoundedCornerShape(8.dp)),\n                contentAlignment = Alignment.Center\n            ) {\n                // Render graded frame\n                gradedBitmap?.let { bmp ->\n                    Image(\n                        bitmap = bmp.asImageBitmap(),\n                        contentDescription = \"Graded Video Viewport\",\n                        contentScale = ContentScale.Fit,\n                        modifier = Modifier.fillMaxSize()\n                    )\n                }\n\n                // If Split wipe is active, overlay raw log on left side\n                if (splitPosition != null && rawBitmap != null) {\n                    Box(modifier = Modifier.fillMaxSize()) {\n                        androidx.compose.foundation.Canvas(\n                            modifier = Modifier\n                                .fillMaxSize()\n                                .pointerInput(Unit) {\n                                    detectDragGestures { change, dragAmount ->\n                                        change.consume()\n                                        val newPos = ((splitPosition ?: 0.5f) + dragAmount.x / size.width).coerceIn(0.05f, 0.95f)\n                                        splitPosition = newPos\n                                    }\n                                }\n                        ) {\n                            val w = size.width\n                            val h = size.height\n                            val splitX = (splitPosition ?: 0.5f) * w\n\n                            // Draw wipe divider line\n                            drawLine(\n                                color = ResolveAmber,\n                                start = Offset(splitX, 0f),\n                                end = Offset(splitX, h),\n                                strokeWidth = 2.dp.toPx()\n                            )\n                            // Draw handle puck\n                            drawCircle(\n                                color = ResolveAmber,\n                                radius = 6.dp.toPx(),\n                                center = Offset(splitX, h / 2f)\n                            )\n                        }\n                    }\n                }\n\n                // Interactive Mask Overlay Guide\n                if (showMaskGuide && mask.type != MaskType.NONE) {\n                    PowerWindowVisualGuide(mask = mask, onMaskChange = onMaskChange)\n                }\n            }\n\n            Spacer(modifier = Modifier.height(6.dp))\n\n            // Timeline Scrubber & Transport Controls\n            Row(\n                verticalAlignment = Alignment.CenterVertically,\n                modifier = Modifier.fillMaxWidth().padding(horizontal = 4.dp)\n            ) {\n                // Step back 1 frame\n                IconButton(\n                    onClick = { onStepFrame(-1) },\n                    modifier = Modifier.size(28.dp).testTag(\"step_back_button\")\n                ) {\n                    Icon(Icons.Default.SkipPrevious, contentDescription = \"Step Back\", tint = TextSecondary, modifier = Modifier.size(16.dp))\n                }\n"
    num_lines: 259
