            }
            lines {
              text: "                val sCurve = if (lum < 0.5f) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    2f * lum * lum"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
