            }
            lines {
              text: "                // Vintage Warm Sepia: nostalgic golden-hour warm shadows with analog softness"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val lum = LR * r + LG * g + LB * b"
