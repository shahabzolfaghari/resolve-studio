            }
            lines {
              text: "                        Text("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            text = title.uppercase(),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            color = TextPrimary,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            fontSize = 11.sp,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
