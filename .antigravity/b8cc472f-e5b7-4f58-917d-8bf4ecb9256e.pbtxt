  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/components/ColorWheel.kt"
    end_line: 311
    content: "package com.example.ui.components\n\nimport androidx.compose.foundation.Canvas\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.gestures.detectDragGestures\nimport androidx.compose.foundation.gestures.detectTapGestures\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.shape.CircleShape\nimport androidx.compose.foundation.shape.RoundedCornerShape\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.filled.Refresh\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.*\nimport androidx.compose.ui.Alignment\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.draw.clip\nimport androidx.compose.ui.geometry.Offset\nimport androidx.compose.ui.graphics.Brush\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.graphics.PathEffect\nimport androidx.compose.ui.graphics.drawscope.Stroke\nimport androidx.compose.ui.input.pointer.pointerInput\nimport androidx.compose.ui.platform.testTag\nimport androidx.compose.ui.text.font.FontFamily\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport com.example.model.WheelValue\nimport com.example.ui.theme.*\nimport kotlin.math.*\n\n@Composable\nfun ColorWheel(\n    title: String,\n    accentColor: Color,\n    value: WheelValue,\n    onValueChange: (WheelValue) -> Unit,\n    modifier: Modifier = Modifier\n) {\n    Card(\n        modifier = modifier\n            .testTag(\"color_wheel_${title.lowercase()}\")\n            .padding(4.dp),\n        colors = CardDefaults.cardColors(containerColor = StudioSurfaceVariant),\n        shape = RoundedCornerShape(12.dp)\n    ) {\n        Column(\n            horizontalAlignment = Alignment.CenterHorizontally,\n            modifier = Modifier.padding(8.dp)\n        ) {\n            // Header: Title & Reset Button\n            Row(\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.SpaceBetween,\n                modifier = Modifier.fillMaxWidth()\n            ) {\n                Row(verticalAlignment = Alignment.CenterVertically) {\n                    Box(\n                        modifier = Modifier\n                            .size(8.dp)\n                            .clip(CircleShape)\n                            .background(accentColor)\n                    )\n                    Spacer(modifier = Modifier.width(6.dp))\n                    Text(\n                        text = title.uppercase(),\n                        color = TextPrimary,\n                        fontSize = 11.sp,\n                        fontWeight = FontWeight.Bold,\n                        letterSpacing = 1.sp\n                    )\n                }\n\n                IconButton(\n                    onClick = { onValueChange(WheelValue(0f, 0f, 0f)) },\n                    modifier = Modifier.size(24.dp).testTag(\"reset_wheel_${title.lowercase()}\")\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.Refresh,\n                        contentDescription = \"Reset $title\",\n                        tint = TextMuted,\n                        modifier = Modifier.size(14.dp)\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.height(4.dp))\n\n            // The Interactive Color Wheel Circle\n            Box(\n                contentAlignment = Alignment.Center,\n                modifier = Modifier\n                    .size(118.dp)\n                    .pointerInput(Unit) {\n                        detectTapGestures(\n                            onDoubleTap = {\n                                onValueChange(value.copy(x = 0f, y = 0f))\n                            }\n                        )\n                    }\n                    .pointerInput(Unit) {\n                        detectDragGestures { change, dragAmount ->\n                            change.consume()\n                            val sensitivity = 0.015f\n                            val newX = (value.x + dragAmount.x * sensitivity).coerceIn(-1f, 1f)\n                            val newY = (value.y - dragAmount.y * sensitivity).coerceIn(-1f, 1f)\n                            // Constrain inside unit circle\n                            val dist = sqrt(newX * newX + newY * newY)\n                            if (dist > 1f) {\n                                onValueChange(value.copy(x = newX / dist, y = newY / dist))\n                            } else {\n                                onValueChange(value.copy(x = newX, y = newY))\n                            }\n                        }\n                    }\n            ) {\n                Canvas(modifier = Modifier.fillMaxSize()) {\n                    val radius = size.minDimension / 2f - 6.dp.toPx()\n                    val center = Offset(size.width / 2f, size.height / 2f)\n\n                    // Draw outer subtle dark background\n                    drawCircle(\n                        color = Color(0xFF141720),\n                        radius = radius,\n                        center = center\n                    )\n\n                    // Draw color spectrum border ring (Red -> Yellow -> Green -> Cyan -> Blue -> Magenta -> Red)\n                    val spectrumSweep = Brush.sweepGradient(\n                        colors = listOf(\n                            Color(0xFFEF4444), // Red\n                            Color(0xFFFBBF24), // Yellow\n                            Color(0xFF10B981), // Green\n                            Color(0xFF06B6D4), // Cyan\n                            Color(0xFF3B82F6), // Blue\n                            Color(0xFFEC4899), // Magenta\n                            Color(0xFFEF4444)  // Red wrap\n                        ),\n                        center = center\n                    )\n\n                    drawCircle(\n                        brush = spectrumSweep,\n                        radius = radius,\n                        center = center,\n                        style = Stroke(width = 3.5.dp.toPx())\n                    )\n\n                    // Inner scope concentric ring\n                    drawCircle(\n                        color = Color(0xFF283143),\n                        radius = radius * 0.5f,\n                        center = center,\n                        style = Stroke(\n                            width = 1.dp.toPx(),\n                            pathEffect = PathEffect.dashPathEffect(floatArrayOf(4f, 4f))\n                        )\n                    )\n\n                    // Crosshair axes\n                    drawLine(\n                        color = Color(0xFF242C3C),\n                        start = Offset(center.x - radius * 0.8f, center.y),\n                        end = Offset(center.x + radius * 0.8f, center.y),\n                        strokeWidth = 1.dp.toPx()\n                    )\n                    drawLine(\n                        color = Color(0xFF242C3C),\n                        start = Offset(center.x, center.y - radius * 0.8f),\n                        end = Offset(center.x, center.y + radius * 0.8f),\n                        strokeWidth = 1.dp.toPx()\n                    )\n\n                    // Active reticle puck position\n                    val puckX = center.x + value.x * radius * 0.85f\n                    val puckY = center.y - value.y * radius * 0.85f // Invert Y for screen coordinates\n\n                    // Glow circle\n                    drawCircle(\n                        color = ResolveAmber.copy(alpha = 0.25f),\n                        radius = 8.dp.toPx(),\n                        center = Offset(puckX, puckY)\n                    )\n                    // Solid reticle\n                    drawCircle(\n                        color = ResolveAmber,\n                        radius = 4.5.dp.toPx(),\n                        center = Offset(puckX, puckY)\n                    )\n                    drawCircle(\n                        color = Color.White,\n                        radius = 2.dp.toPx(),\n                        center = Offset(puckX, puckY)\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.height(4.dp))\n\n            // Coordinates Readout\n            Row(\n                horizontalArrangement = Arrangement.SpaceBetween,\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .padding(horizontal = 4.dp)\n            ) {\n                Text(\n                    text = String.format(\"X: %+.2f\", value.x),\n                    color = TextSecondary,\n                    fontSize = 9.sp,\n                    fontFamily = FontFamily.Monospace\n                )\n                Text(\n                    text = String.format(\"Y: %+.2f\", value.y),\n                    color = TextSecondary,\n                    fontSize = 9.sp,\n                    fontFamily = FontFamily.Monospace\n                )\n            }\n\n            Spacer(modifier = Modifier.height(2.dp))\n\n            // Master Luminance Wheel Slider underneath\n            LuminanceWheelSlider(\n                lumValue = value.lum,\n                onLumChange = { newLum -> onValueChange(value.copy(lum = newLum)) }\n            )\n        }\n    }\n}\n\n@Composable\nfun LuminanceWheelSlider(\n    lumValue: Float,\n    onLumChange: (Float) -> Unit,\n    modifier: Modifier = Modifier\n) {\n    Column(\n        horizontalAlignment = Alignment.CenterHorizontally,\n        modifier = modifier.fillMaxWidth()\n    ) {\n        Box(\n            modifier = Modifier\n                .fillMaxWidth()\n                .height(26.dp)\n                .clip(RoundedCornerShape(6.dp))\n                .background(Color(0xFF10131A))\n                .pointerInput(Unit) {\n                    detectDragGestures { change, dragAmount ->\n                        change.consume()\n                        val sensitivity = 0.015f\n                        val updated = (lumValue + dragAmount.x * sensitivity).coerceIn(-1f, 1f)\n                        onLumChange(updated)\n                    }\n                }\n                .pointerInput(Unit) {\n                    detectTapGestures(\n                        onDoubleTap = { onLumChange(0f) }\n                    )\n                },\n            contentAlignment = Alignment.Center\n        ) {\n            Canvas(modifier = Modifier.fillMaxSize()) {\n                val w = size.width\n                val h = size.height\n                val midX = w / 2f\n\n                // Draw tick marks like a real studio hardware jog wheel\n                val numTicks = 21\n                val spacing = w / (numTicks + 1)\n                for (i in 1..numTicks) {\n                    val tx = i * spacing\n                    val isCenter = i == (numTicks + 1) / 2\n                    val tickHeight = if (isCenter) h * 0.7f else h * 0.35f\n                    val color = if (isCenter) ResolveAmber else Color(0xFF283142)\n                    drawLine(\n                        color = color,\n                        start = Offset(tx, (h - tickHeight) / 2f),\n                        end = Offset(tx, (h + tickHeight) / 2f),\n                        strokeWidth = if (isCenter) 2.dp.toPx() else 1.dp.toPx()\n                    )\n                }\n\n                // Active luminance needle\n                val indicatorX = (midX + lumValue * (w * 0.42f)).coerceIn(4.dp.toPx(), w - 4.dp.toPx())\n                drawLine(\n                    color = ResolveAmber,\n                    start = Offset(indicatorX, 0f),\n                    end = Offset(indicatorX, h),\n                    strokeWidth = 2.5.dp.toPx()\n                )\n            }\n        }\n\n        Spacer(modifier = Modifier.height(2.dp))\n\n        Row(\n            horizontalArrangement = Arrangement.SpaceBetween,\n            modifier = Modifier.fillMaxWidth().padding(horizontal = 4.dp)\n        ) {\n            Text(\"LUM\", color = TextMuted, fontSize = 8.sp, fontWeight = FontWeight.Bold)\n            Text(\n                text = String.format(\"%+.2f\", lumValue),\n                color = if (lumValue == 0f) TextSecondary else ResolveAmber,\n                fontSize = 9.sp,\n                fontFamily = FontFamily.Monospace,\n                fontWeight = FontWeight.Bold\n            )\n        }\n    }\n}\n"
    num_lines: 312
    num_bytes: 12231
    line_range_bytes: 12231
  }
}
