      arguments_json: "{\"questions\":[{\"is_multi_select\":false,\"options\":[\"(Recommended) Full MP4 video export with LUT and frame export\",\"Generate and export .cube 3D LUTs for editing\",\"Export high-resolution graded still frames only\"],\"question\":\"What is your primary workflow for graded videos?\"},{\"is_multi_select\":false,\"options\":[\"(Recommended) Studio dock with scopes, color wheels, and curves\",\"Minimal bottom sheets with gesture controls\",\"Expanded landscape multi-panel workspace\"],\"question\":\"How would you like the color grading interface organized?\"},{\"is_multi_select\":false,\"options\":[\"(Recommended) Samsung Log with S24 Ultra Rec.709 transform\",\"HDR10+ BT.2020 wide color gamut\",\"Standard flat profile video\"],\"question\":\"Which Samsung S24 Ultra profile will you grade most often?\"}],\"toolAction\":\"Asking user clarifying questions\",\"toolSummary\":\"Clarifying color grading workflow and preferences\"}"
