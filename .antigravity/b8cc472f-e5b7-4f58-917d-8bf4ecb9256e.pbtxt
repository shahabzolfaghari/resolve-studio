      thinking_signature: "\022\311\022\n\306\022\001i\024}\023\327\237\324d\355\332\360$\245\360\302:\325\371$\314\345\\h\260\037H\350\352v\270F\266x`]a\267\v\265\344\tn\264^\303n\360, \275\261\377\240\234\241\254?\243U\210\255/\246\323\205\213\234\373.\354,\321\243\253\325\217?\357\375j\177\23645\333\375\253\f\264\240\vGa_\326_\254\227\207\000\204\341\243\035n`\234\266\332\320*\262c\216\023\263\025\337\215rL69$|\316\v\241h\250QY\tF\232\304SAn\260Q\276\327\356\036\241x\334\3640\222\256\261\252\210\361\t<\3700\331\365\217jx\3619A\236d!k\263y\266tF\021\353\t\276XCZ\221\325I\003\255\377\360\361\325\334\256}\262{\367\226T\316\021W\366\2577\270\256s\347\fq7l\265\001\305\a\246\302\233\033\004\272)\214\006\373\226@\322\205|\366}\231\f\307\332Y:\001\307\345D\254\377\212\v?\316S+\177,\275\206:k\327\336Z\313[f\206\246q\373\353`\201\314\022\017\207\216y6:\303?X\251\022\340\016p\034\265\342\275x\373\353\306~J\276\201\375\310a\310(S\362\232\352\372\243\225\205\223f\245&A\217@\241l\370\177\020p\304\351\265\345\002l\277\244\210A]\005\251\272\252\030\006\322\273\327\250\243\366\tc\217\327\376Z\246tA\263\352\367\307L\bzT#\324\352\b\314\276Y\353\265EF\242\v\226Q\270.P\265]\\\266}\236L\330)\336\331\363\b\204A*\bL\337\322\331\332\241\'\364\023\342\177M]!\t\344\2620\027\275\034A\227\204E:\nb\033Y\332\235B\343\0318\347\215v\347Qco\220I#\251[\213\244\026@\221\355\370\215\314Q\373\364F\r=\230\217\303\375\253\317\273Fw\306\246\342\024o\023\\\370\270-\034\354Sd\r.w\251m\034\277!~\2227s\317\352?K\266\352\032\020\325a\"\221\nn\244\213T\353\330z\251\302\271\210\006q\302\036\322i\206\202X\210\370\a\344\273$\341PK\006k\207\305\301\000,\343\315\344\343\250\304\336\005.\006\0243\031.\n\'\216\251\331\"(\b\3717\314\3019\243P\304\267\214\240L\221\0321\031\252\322b\247\004\3410\355\233e\344\234f\265\274\326\277pS\241\0366\275\326\277M\202\201\264\250QH\332\262D\274\003\264@\353qmD2\261:\227\006@EDy\267\004\337dYd\027\220~\356/|R\316\353#\225Y\2735\205\v\356\275\320\250\272\000?W\250\032,p\313\374\343=