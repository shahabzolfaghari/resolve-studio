          target_content: "        // Velvia should have punchier saturation than Astia\n        val (vr, _, vb) = SamsungLogColorScience.applyLutPreset(0.7f, 0.4f, 0.2f, LutPreset.FUJI_VELVIA)\n        val (asr, _, asb) = SamsungLogColorScience.applyLutPreset(0.7f, 0.4f, 0.2f, LutPreset.FUJI_ASTIA)\n        assertTrue(\"Velvia red saturation punch\", (vr - vb) > (asr - asb))\n    }\n}"
          replacement_content: "        // Velvia should have punchier saturation than Astia\n        val (vr, _, vb) = SamsungLogColorScience.applyLutPreset(0.7f, 0.4f, 0.2f, LutPreset.FUJI_VELVIA)\n        val (asr, _, asb) = SamsungLogColorScience.applyLutPreset(0.7f, 0.4f, 0.2f, LutPreset.FUJI_ASTIA)\n        assertTrue(\"Velvia red saturation punch\", (vr - vb) > (asr - asb))\n    }\n\n    @Test\n    fun testRealtimeHistogramCalculation() {\n        val bmp = android.graphics.Bitmap.createBitmap(100, 100, android.graphics.Bitmap.Config.ARGB_8888)\n        for (y in 0 until 100) {\n            for (x in 0 until 100) {\n                val color = if (x < 50) {\n                    (0xFF shl 24) or (0 shl 16) or (0 shl 8) or 0\n                } else {\n                    (0xFF shl 24) or (118 shl 16) or (118 shl 8) or 118\n                }\n                bmp.setPixel(x, y, color)\n            }\n        }\n\n        val histo = SamsungLogColorScience.calculateHistogram(bmp)\n        assertEquals(256, histo.lumBins.size)\n        assertEquals(256, histo.redBins.size)\n        assertEquals(256, histo.greenBins.size)\n        assertEquals(256, histo.blueBins.size)\n        assertTrue(histo.totalSamples > 0)\n        assertTrue(\"Shadow crush should be detected\", histo.shadowClipPct > 30f)\n        assertEquals(0f, histo.highlightClipPct, 0.01f)\n        assertTrue(histo.avgLum in 40f..70f)\n    }\n}"
          start_line: 439
          end_line: 445
        }
      }
    }
