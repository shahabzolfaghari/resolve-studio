  code_action {
    action_spec {
      command {
        instruction: "Add undo/redo state collection, buttons, and HistoryDialog in GradingStudioScreen"
        is_edit: true
        file {
          absolute_uri: "file:///app/src/main/java/com/example/ui/GradingStudioScreen.kt"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "    val totalDurationMs by viewModel.totalDurationMs.collectAsStateWithLifecycle()\n\n    val isExporting by viewModel.isExporting.collectAsStateWithLifecycle()\n    val exportProgress by viewModel.exportProgress.collectAsStateWithLifecycle()\n    val exportStatusMessage by viewModel.exportStatusMessage.collectAsStateWithLifecycle()\n\n    var activeTab by remember { mutableStateOf(StudioToolTab.WHEELS) }\n    var showScopes by remember { mutableStateOf(false) }\n    var showSceneMenu by remember { mutableStateOf(false) }\n    var showExportDialog by remember { mutableStateOf(false) }\n\n    // Android Zero-Permission Photo/Video Picker (compliant with Google Play policies)\n    val videoPickerLauncher = rememberLauncherForActivityResult(\n        contract = ActivityResultContracts.PickVisualMedia()\n    ) { uri: Uri? ->\n        if (uri != null) {\n            viewModel.onImportVideoUri(uri)\n            Toast.makeText(context, \"Loaded Samsung S24 video clip\", Toast.LENGTH_SHORT).show()\n        }\n    }\n\n    // .cube LUT File Picker\n    val cubeFileLauncher = rememberLauncherForActivityResult(\n        contract = ActivityResultContracts.OpenDocument()\n    ) { uri: Uri? ->\n        if (uri != null) {\n            try {\n                val content = context.contentResolver.openInputStream(uri)?.bufferedReader()?.use { it.readText() }\n                if (content != null) {\n                    viewModel.onImportCubeLut(content)\n                    Toast.makeText(context, \"Imported custom .cube 3D LUT!\", Toast.LENGTH_SHORT).show()\n                }\n            } catch (e: Exception) {\n                Toast.makeText(context, \"Failed to read .cube file\", Toast.LENGTH_SHORT).show()\n            }\n        }\n    }\n\n    Scaffold(\n        modifier = modifier\n            .fillMaxSize()\n            .background(StudioBackground),\n        containerColor = StudioBackground,\n        topBar = {\n            TopAppBar(\n                title = {\n                    Row(verticalAlignment = Alignment.CenterVertically) {\n                        Text(\n                            text = \"RESOLVE\",\n                            color = TextPrimary,\n                            fontWeight = FontWeight.Black,\n                            fontSize = 15.sp,\n                            letterSpacing = 1.sp\n                        )\n                        Text(\n                            text = \"STUDIO\",\n                            color = ResolveAmber,\n                            fontWeight = FontWeight.Black,\n                            fontSize = 15.sp,\n                            letterSpacing = 1.sp\n                        )\n\n                        Spacer(modifier = Modifier.width(8.dp))\n\n                        // S24 Ultra Log badge\n                        Box(\n                            modifier = Modifier\n                                .clip(RoundedCornerShape(4.dp))\n                                .background(Color(0xFF252F42))\n                                .padding(horizontal = 6.dp, vertical = 2.dp)\n                        ) {\n                            Text(\n                                text = \"S24 LOG 4K\",\n                                color = ResolveCyan,\n                                fontSize = 8.5.sp,\n                                fontWeight = FontWeight.Bold\n                            )\n                        }\n                    }\n                },\n                actions = {\n                    // Scene selector menu\n                    Box {\n                        IconButton(\n                            onClick = { showSceneMenu = true },\n                            modifier = Modifier.testTag(\"scene_selector_button\")\n                        ) {\n                            Icon(Icons.Default.VideoLibrary, contentDescription = \"Scenes\", tint = TextSecondary)\n                        }\n\n                        DropdownMenu(\n                            expanded = showSceneMenu,\n                            onDismissRequest = { showSceneMenu = false },\n                            modifier = Modifier.background(StudioSurfaceVariant)\n                        ) {\n                            DropdownMenuItem(\n                                text = { Text(\"Import Camera Roll Video...\", color = ResolveCyan, fontWeight = FontWeight.Bold) },\n                                leadingIcon = { Icon(Icons.Default.UploadFile, contentDescription = null, tint = ResolveCyan) },\n                                onClick = {\n                                    showSceneMenu = false\n                                    videoPickerLauncher.launch(PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.VideoOnly))\n                                },\n                                modifier = Modifier.testTag(\"import_video_menu_item\")\n                            )\n\n                            HorizontalDivider(color = StudioCardBorder)\n\n                            SampleScene.values().forEach { scene ->\n                                DropdownMenuItem(\n                                    text = { Text(scene.sceneName, color = TextPrimary, fontSize = 12.sp) },\n                                    leadingIcon = {\n                                        Icon(\n                                            Icons.Default.Movie,\n                                            contentDescription = null,\n                                            tint = if (currentScene == scene) ResolveAmber else TextMuted\n                                        )\n                                    },\n                                    onClick = {\n                                        showSceneMenu = false\n                                        viewModel.loadScene(scene)\n                                    }\n                                )\n                            }\n                        }\n                    }\n\n                    // Reset Grade button\n                    IconButton(\n                        onClick = {\n                            viewModel.updateSettings { ColorGradeSettings() }\n                            Toast.makeText(context, \"Reset all color wheels and curves\", Toast.LENGTH_SHORT).show()\n                        },\n                        modifier = Modifier.testTag(\"reset_all_grade_button\")\n                    ) {\n                        Icon(Icons.Default.RestartAlt, contentDescription = \"Reset Grade\", tint = TextMuted)\n                    }\n\n                    // Export Button CTA\n                    Button(\n                        onClick = { showExportDialog = true },\n                        colors = ButtonDefaults.buttonColors(containerColor = ResolveAmber),\n                        contentPadding = PaddingValues(horizontal = 10.dp, vertical = 4.dp),\n                        shape = RoundedCornerShape(8.dp),\n                        modifier = Modifier\n                            .height(32.dp)\n                            .padding(end = 6.dp)\n                            .testTag(\"open_export_dialog_button\")\n                    ) {\n                        Icon(Icons.Default.Share, contentDescription = null, tint = Color(0xFF1E1400), modifier = Modifier.size(14.dp))\n                        Spacer(modifier = Modifier.width(4.dp))\n                        Text(\"EXPORT\", color = Color(0xFF1E1400), fontSize = 11.sp, fontWeight = FontWeight.Black)\n                    }\n                },\n                colors = TopAppBarDefaults.topAppBarColors(containerColor = StudioSurface)\n            )\n        },\n        bottomBar = {\n            // Studio Dock Bottom Navigation\n            StudioDockTabs(\n                activeTab = activeTab,\n                onTabSelected = { activeTab = it },\n                showScopes = showScopes,\n                onToggleScopes = { showScopes = !showScopes },\n                modifier = Modifier\n                    .windowInsetsPadding(WindowInsets.navigationBars)\n                    .padding(horizontal = 6.dp, vertical = 4.dp)\n            )\n        }\n    ) { innerPadding ->\n        Column(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(innerPadding)\n                .verticalScroll(rememberScrollState())\n        ) {\n            // 1. Video Player Viewport\n            VideoPlayerView(\n                gradedBitmap = gradedBitmap,\n                rawBitmap = rawBitmap,\n                isPlaying = isPlaying,\n                currentTimeMs = currentTimeMs,\n                totalDurationMs = totalDurationMs,\n                mask = settings.mask,\n                showMaskGuide = activeTab == StudioToolTab.MASK,\n                onMaskChange = { newMask -> viewModel.updateSettings { it.copy(mask = newMask) } },\n                onPlayPauseToggle = { viewModel.togglePlayPause() },\n                onSeek = { viewModel.seekTo(it) },\n                onStepFrame = { viewModel.stepFrame(it) },\n                onBypassPress = { viewModel.setBypass(it) }\n            )\n\n            Spacer(modifier = Modifier.height(4.dp))\n\n            // 2. Dedicated UI Studio Dock Container\n            // Hosts Color Wheels, Curve Editors, and Real-time Broadcast Scopes\n            StudioDockContainer(\n                activeTab = activeTab,\n                onTabSelected = { activeTab = it },\n                settings = settings,\n                onSettingsChange = { transform -> viewModel.updateSettings(transform) },\n                previewBitmap = gradedBitmap,\n                onImportCubeClick = { cubeFileLauncher.launch(arrayOf(\"*/*\")) },\n                modifier = Modifier.fillMaxWidth()\n            )\n\n            Spacer(modifier = Modifier.height(16.dp))"
          replacement_content: "    val totalDurationMs by viewModel.totalDurationMs.collectAsStateWithLifecycle()\n\n    val canUndo by viewModel.canUndo.collectAsStateWithLifecycle()\n    val canRedo by viewModel.canRedo.collectAsStateWithLifecycle()\n    val historyEntries by viewModel.historyEntries.collectAsStateWithLifecycle()\n    val historyActionToast by viewModel.historyActionToast.collectAsStateWithLifecycle()\n\n    val isExporting by viewModel.isExporting.collectAsStateWithLifecycle()\n    val exportProgress by viewModel.exportProgress.collectAsStateWithLifecycle()\n    val exportStatusMessage by viewModel.exportStatusMessage.collectAsStateWithLifecycle()\n\n    var activeTab by remember { mutableStateOf(StudioToolTab.WHEELS) }\n    var showScopes by remember { mutableStateOf(false) }\n    var showSceneMenu by remember { mutableStateOf(false) }\n    var showExportDialog by remember { mutableStateOf(false) }\n    var showHistoryDialog by remember { mutableStateOf(false) }\n\n    // Auto-dismiss history toast after 2 seconds\n    LaunchedEffect(historyActionToast) {\n        if (historyActionToast != null) {\n            kotlinx.coroutines.delay(2000L)\n            viewModel.clearActionToast()\n        }\n    }\n\n    // Android Zero-Permission Photo/Video Picker (compliant with Google Play policies)\n    val videoPickerLauncher = rememberLauncherForActivityResult(\n        contract = ActivityResultContracts.PickVisualMedia()\n    ) { uri: Uri? ->\n        if (uri != null) {\n            viewModel.onImportVideoUri(uri)\n            Toast.makeText(context, \"Loaded Samsung S24 video clip\", Toast.LENGTH_SHORT).show()\n        }\n    }\n\n    // .cube LUT File Picker\n    val cubeFileLauncher = rememberLauncherForActivityResult(\n        contract = ActivityResultContracts.OpenDocument()\n    ) { uri: Uri? ->\n        if (uri != null) {\n            try {\n                val content = context.contentResolver.openInputStream(uri)?.bufferedReader()?.use { it.readText() }\n                if (content != null) {\n                    viewModel.onImportCubeLut(content)\n                    Toast.makeText(context, \"Imported custom .cube 3D LUT!\", Toast.LENGTH_SHORT).show()\n                }\n            } catch (e: Exception) {\n                Toast.makeText(context, \"Failed to read .cube file\", Toast.LENGTH_SHORT).show()\n            }\n        }\n    }\n\n    Scaffold(\n        modifier = modifier\n            .fillMaxSize()\n            .background(StudioBackground),\n        containerColor = StudioBackground,\n        topBar = {\n            TopAppBar(\n                title = {\n                    Row(verticalAlignment = Alignment.CenterVertically) {\n                        Text(\n                            text = \"RESOLVE\",\n                            color = TextPrimary,\n                            fontWeight = FontWeight.Black,\n                            fontSize = 15.sp,\n                            letterSpacing = 1.sp\n                        )\n                        Text(\n                            text = \"STUDIO\",\n                            color = ResolveAmber,\n                            fontWeight = FontWeight.Black,\n                            fontSize = 15.sp,\n                            letterSpacing = 1.sp\n                        )\n\n                        Spacer(modifier = Modifier.width(6.dp))\n\n                        // S24 Ultra Log badge\n                        Box(\n                            modifier = Modifier\n                                .clip(RoundedCornerShape(4.dp))\n                                .background(Color(0xFF252F42))\n                                .padding(horizontal = 5.dp, vertical = 2.dp)\n                        ) {\n                            Text(\n                                text = \"S24 LOG\",\n                                color = ResolveCyan,\n                                fontSize = 8.sp,\n                                fontWeight = FontWeight.Bold\n                            )\n                        }\n                    }\n                },\n                actions = {\n                    // Undo Button\n                    IconButton(\n                        onClick = { viewModel.undo() },\n                        enabled = canUndo,\n                        modifier = Modifier.size(32.dp).testTag(\"undo_button\")\n                    ) {\n                        Icon(\n                            imageVector = Icons.Default.Undo,\n                            contentDescription = \"Undo\",\n                            tint = if (canUndo) ResolveAmber else TextMuted.copy(alpha = 0.35f),\n                            modifier = Modifier.size(18.dp)\n                        )\n                    }\n\n                    // Redo Button\n                    IconButton(\n                        onClick = { viewModel.redo() },\n                        enabled = canRedo,\n                        modifier = Modifier.size(32.dp).testTag(\"redo_button\")\n                    ) {\n                        Icon(\n                            imageVector = Icons.Default.Redo,\n                            contentDescription = \"Redo\",\n                            tint = if (canRedo) ResolveAmber else TextMuted.copy(alpha = 0.35f),\n                            modifier = Modifier.size(18.dp)\n                        )\n                    }\n\n                    // History Stack Button\n                    IconButton(\n                        onClick = { showHistoryDialog = true },\n                        modifier = Modifier.size(32.dp).testTag(\"history_button\")\n                    ) {\n                        BadgedBox(\n                            badge = {\n                                if (historyEntries.size > 1) {\n                                    Badge(\n                                        containerColor = ResolveAmber,\n                                        contentColor = Color(0xFF1E1400)\n                                    ) {\n                                        Text(\"${historyEntries.size - 1}\", fontSize = 7.5.sp, fontWeight = FontWeight.Bold)\n                                    }\n                                }\n                            }\n                        ) {\n                            Icon(\n                                imageVector = Icons.Default.History,\n                                contentDescription = \"History Stack\",\n                                tint = TextSecondary,\n                                modifier = Modifier.size(18.dp)\n                            )\n                        }\n                    }\n\n                    // Scene selector menu\n                    Box {\n                        IconButton(\n                            onClick = { showSceneMenu = true },\n                            modifier = Modifier.size(32.dp).testTag(\"scene_selector_button\")\n                        ) {\n                            Icon(Icons.Default.VideoLibrary, contentDescription = \"Scenes\", tint = TextSecondary, modifier = Modifier.size(18.dp))\n                        }\n\n                        DropdownMenu(\n                            expanded = showSceneMenu,\n                            onDismissRequest = { showSceneMenu = false },\n                            modifier = Modifier.background(StudioSurfaceVariant)\n                        ) {\n                            DropdownMenuItem(\n                                text = { Text(\"Import Camera Roll Video...\", color = ResolveCyan, fontWeight = FontWeight.Bold) },\n                                leadingIcon = { Icon(Icons.Default.UploadFile, contentDescription = null, tint = ResolveCyan) },\n                                onClick = {\n                                    showSceneMenu = false\n                                    videoPickerLauncher.launch(PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.VideoOnly))\n                                },\n                                modifier = Modifier.testTag(\"import_video_menu_item\")\n                            )\n\n                            HorizontalDivider(color = StudioCardBorder)\n\n                            SampleScene.values().forEach { scene ->\n                                DropdownMenuItem(\n                                    text = { Text(scene.sceneName, color = TextPrimary, fontSize = 12.sp) },\n                                    leadingIcon = {\n                                        Icon(\n                                            Icons.Default.Movie,\n                                            contentDescription = null,\n                                            tint = if (currentScene == scene) ResolveAmber else TextMuted\n                                        )\n                                    },\n                                    onClick = {\n                                        showSceneMenu = false\n                                        viewModel.loadScene(scene)\n                                    }\n                                )\n                            }\n                        }\n                    }\n\n                    // Reset Grade button\n                    IconButton(\n                        onClick = {\n                            viewModel.resetGrade()\n                            Toast.makeText(context, \"Reset all color wheels and curves\", Toast.LENGTH_SHORT).show()\n                        },\n                        modifier = Modifier.size(32.dp).testTag(\"reset_all_grade_button\")\n                    ) {\n                        Icon(Icons.Default.RestartAlt, contentDescription = \"Reset Grade\", tint = TextMuted, modifier = Modifier.size(18.dp))\n                    }\n\n                    Spacer(modifier = Modifier.width(2.dp))\n\n                    // Export Button CTA\n                    Button(\n                        onClick = { showExportDialog = true },\n                        colors = ButtonDefaults.buttonColors(containerColor = ResolveAmber),\n                        contentPadding = PaddingValues(horizontal = 8.dp, vertical = 2.dp),\n                        shape = RoundedCornerShape(6.dp),\n                        modifier = Modifier\n                            .height(28.dp)\n                            .padding(end = 4.dp)\n                            .testTag(\"open_export_dialog_button\")\n                    ) {\n                        Icon(Icons.Default.Share, contentDescription = null, tint = Color(0xFF1E1400), modifier = Modifier.size(12.dp))\n                        Spacer(modifier = Modifier.width(3.dp))\n                        Text(\"EXPORT\", color = Color(0xFF1E1400), fontSize = 10.sp, fontWeight = FontWeight.Black)\n                    }\n                },\n                colors = TopAppBarDefaults.topAppBarColors(containerColor = StudioSurface)\n            )\n        },\n        bottomBar = {\n            // Studio Dock Bottom Navigation\n            StudioDockTabs(\n                activeTab = activeTab,\n                onTabSelected = { activeTab = it },\n                showScopes = showScopes,\n                onToggleScopes = { showScopes = !showScopes },\n                modifier = Modifier\n                    .windowInsetsPadding(WindowInsets.navigationBars)\n                    .padding(horizontal = 6.dp, vertical = 4.dp)\n            )\n        }\n    ) { innerPadding ->\n        Box(modifier = Modifier.fillMaxSize()) {\n            Column(\n                modifier = Modifier\n                    .fillMaxSize()\n                    .padding(innerPadding)\n                    .verticalScroll(rememberScrollState())\n            ) {\n                // 1. Video Player Viewport\n                VideoPlayerView(\n                    gradedBitmap = gradedBitmap,\n                    rawBitmap = rawBitmap,\n                    isPlaying = isPlaying,\n                    currentTimeMs = currentTimeMs,\n                    totalDurationMs = totalDurationMs,\n                    mask = settings.mask,\n                    showMaskGuide = activeTab == StudioToolTab.MASK,\n                    onMaskChange = { newMask ->\n                        viewModel.updateSettings(description = \"Adjust Power Window\") { it.copy(mask = newMask) }\n                    },\n                    onPlayPauseToggle = { viewModel.togglePlayPause() },\n                    onSeek = { viewModel.seekTo(it) },\n                    onStepFrame = { viewModel.stepFrame(it) },\n                    onBypassPress = { viewModel.setBypass(it) }\n                )\n\n                Spacer(modifier = Modifier.height(4.dp))\n\n                // 2. Dedicated UI Studio Dock Container\n                // Hosts Color Wheels, Curve Editors, and Real-time Broadcast Scopes with History Logging\n                StudioDockContainer(\n                    activeTab = activeTab,\n                    onTabSelected = { activeTab = it },\n                    settings = settings,\n                    onSettingsChange = { description, transform ->\n                        viewModel.updateSettings(description = description, transform = transform)\n                    },\n                    previewBitmap = gradedBitmap,\n                    onImportCubeClick = { cubeFileLauncher.launch(arrayOf(\"*/*\")) },\n                    modifier = Modifier.fillMaxWidth()\n                )\n\n                Spacer(modifier = Modifier.height(16.dp))\n            }\n\n            // Floating History Action HUD Banner\n            AnimatedVisibility(\n                visible = historyActionToast != null,\n                enter = fadeIn() + expandVertically(expandFrom = Alignment.Top),\n                exit = fadeOut() + shrinkVertically(shrinkTowards = Alignment.Top),\n                modifier = Modifier\n                    .align(Alignment.TopCenter)\n                    .padding(top = innerPadding.calculateTopPadding() + 8.dp)\n            ) {\n                historyActionToast?.let { toastText ->\n                    Box(\n                        modifier = Modifier\n                            .clip(RoundedCornerShape(20.dp))\n                            .background(Color(0xEE1E2433))\n                            .border(1.dp, ResolveAmber.copy(alpha = 0.5f), RoundedCornerShape(20.dp))\n                            .padding(horizontal = 14.dp, vertical = 6.dp)\n                    ) {\n                        Row(verticalAlignment = Alignment.CenterVertically) {\n                            Icon(\n                                imageVector = if (toastText.startsWith(\"Undo\")) Icons.Default.Undo else Icons.Default.Redo,\n                                contentDescription = null,\n                                tint = ResolveAmber,\n                                modifier = Modifier.size(13.dp)\n                            )\n                            Spacer(modifier = Modifier.width(6.dp))\n                            Text(\n                                text = toastText,\n                                color = TextPrimary,\n                                fontSize = 11.sp,\n                                fontWeight = FontWeight.Bold,\n                                fontFamily = FontFamily.Monospace\n                            )\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    // Grade History Dialog\n    if (showHistoryDialog) {\n        HistoryDialog(\n            historyEntries = historyEntries,\n            onDismiss = { showHistoryDialog = false },\n            onSelectEntry = { entry ->\n                viewModel.jumpToHistory(entry)\n                showHistoryDialog = false\n            },\n            onResetAll = {\n                viewModel.resetGrade()\n                showHistoryDialog = false\n            }\n        )\n    }"
