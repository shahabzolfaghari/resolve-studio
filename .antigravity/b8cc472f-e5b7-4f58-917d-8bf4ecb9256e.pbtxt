  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/color/SamsungLogColorScience.kt"
    start_line: 304
    end_line: 329
    content: "                }\n\n                // 2. Exposure & White Balance (Temp / Tint)\n                r *= exposureScale\n                g *= exposureScale\n                b *= exposureScale\n\n                if (tempVal != 0f) {\n                    // Warm / Cool\n                    r += tempVal * 0.15f\n                    b -= tempVal * 0.15f\n                }\n                if (tintVal != 0f) {\n                    // Magenta / Green\n                    g -= tintVal * 0.12f\n                    r += tintVal * 0.05f\n                    b += tintVal * 0.05f\n                }\n\n                // 3. DaVinci Resolve Lift / Gamma / Gain / Offset Color Wheels\n                var lum = LR * r + LG * g + LB * b\n\n                // Lift (Shadows)\n                val liftWeight = ((1f - lum).coerceIn(0f, 1f)).pow(2)\n                r += (liftR * 0.25f + liftLum * 0.2f) * liftWeight\n                g += (liftG * 0.25f + liftLum * 0.2f) * liftWeight"
    num_lines: 786
    num_bytes: 31076
    line_range_bytes: 945
  }
