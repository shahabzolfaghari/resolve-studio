              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            val newRx = (mask.radiusX - dx).coerceIn(0.05f, 0.5f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            onMaskChange(mask.copy(radiusX = newRx))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
