      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHsUJNRnf7W-sPcaGMBfiXiPdXlabWqyWtjV4rHQMe-oSLOAUupghQ7dV2gznop13KoIWu60pRTgbe_feZgLvjU2tjyjifPzAgzmmyLpa8uoYm9bbAboJBlose6P22sAVyJBzIFu5AlIIj7HprsPWAxrw=="
      title: "samsung.com"
