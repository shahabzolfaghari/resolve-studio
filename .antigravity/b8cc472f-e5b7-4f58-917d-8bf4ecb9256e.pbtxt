              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            modifier = Modifier.size(22.dp).testTag(\"precision_mode_${title.lowercase()}\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        ) {"
