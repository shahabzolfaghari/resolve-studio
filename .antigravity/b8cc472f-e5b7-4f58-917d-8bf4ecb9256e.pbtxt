              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val sb = StringBuilder()"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        sb.append(\"# DaVinci Resolve 3D LUT Exported by ResolveStudio Mobile\\n\")"
