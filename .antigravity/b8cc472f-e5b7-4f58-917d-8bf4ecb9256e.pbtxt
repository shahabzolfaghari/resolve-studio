            }
            lines {
              text: "            return null"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        return null"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    /**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "     * Calculate 256-bin RGB and Luminance Histogram data with real-time clipping detection."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "     */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    fun calculateHistogram(bitmap: Bitmap): HistogramData {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val rBins = IntArray(256)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val gBins = IntArray(256)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val bBins = IntArray(256)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val lumBins = IntArray(256)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val w = bitmap.width"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val h = bitmap.height"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Downsample for instant computation"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val stepX = (w / 120).coerceAtLeast(1)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val stepY = (h / 80).coerceAtLeast(1)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val pixels = IntArray(w * h)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        bitmap.getPixels(pixels, 0, w, 0, 0, w, h)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        var totalSamples = 0"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        var shadowClipCount = 0"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        var highlightClipCount = 0"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        var lumSum = 0L"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        var minL = 255"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        var maxL = 0"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        for (y in 0 until h step stepY) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            val offset = y * w"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            for (x in 0 until w step stepX) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val p = pixels[offset + x]"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val r = AndroidColor.red(p)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val g = AndroidColor.green(p)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val b = AndroidColor.blue(p)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val l = (0.2126f * r + 0.7152f * g + 0.0722f * b).toInt().coerceIn(0, 255)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                rBins[r]++"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                gBins[g]++"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                bBins[b]++"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                lumBins[l]++"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                totalSamples++"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                lumSum += l"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                if (l < minL) minL = l"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                if (l > maxL) maxL = l"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                // Clipping detection: < 3 is crushed black (<1% IRE), > 252 is blown white (>99% IRE)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                if (l <= 3) shadowClipCount++"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                if (l >= 252) highlightClipCount++"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val avgLum = if (totalSamples > 0) lumSum.toFloat() / totalSamples else 128f"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val shadowClipPct = if (totalSamples > 0) (shadowClipCount.toFloat() / totalSamples) * 100f else 0f"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val highlightClipPct = if (totalSamples > 0) (highlightClipCount.toFloat() / totalSamples) * 100f else 0f"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        return HistogramData("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            redBins = rBins,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            greenBins = gBins,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            blueBins = bBins,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            lumBins = lumBins,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            totalSamples = totalSamples,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            shadowClipPct = shadowClipPct,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            highlightClipPct = highlightClipPct,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            avgLum = avgLum,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            minLum = minL,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            maxLum = maxL"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        )"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    /**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "     * Calculate Waveform RGB Parade columns (100 bins vertical, column sample horizontal)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "     */"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    fun calculateWaveform(bitmap: Bitmap): WaveformData {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val columns = 90"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val rows = 80"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val rGrid = Array(columns) { FloatArray(rows) }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val gGrid = Array(columns) { FloatArray(rows) }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val bGrid = Array(columns) { FloatArray(rows) }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val w = bitmap.width"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val h = bitmap.height"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val pixels = IntArray(w * h)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        bitmap.getPixels(pixels, 0, w, 0, 0, w, h)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val colStep = w / columns"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val rowStep = h / 60"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        for (col in 0 until columns) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            val startX = col * colStep"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            for (y in 0 until h step rowStep) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val p = pixels[y * w + startX]"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val rNorm = (AndroidColor.red(p) / 255f * (rows - 1)).toInt()"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val gNorm = (AndroidColor.green(p) / 255f * (rows - 1)).toInt()"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val bNorm = (AndroidColor.blue(p) / 255f * (rows - 1)).toInt()"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                rGrid[col][rNorm.coerceIn(0, rows - 1)] += 1f"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                gGrid[col][gNorm.coerceIn(0, rows - 1)] += 1f"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                bGrid[col][bNorm.coerceIn(0, rows - 1)] += 1f"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        return WaveformData(rGrid, gGrid, bGrid, columns, rows)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    /**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     * DaVinci Resolve Color Space Transform (CST) Output Node."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     * Maps wide-gamut log signals (DWG, BT.2020) to output delivery spaces (Rec.709, DCI-P3)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    fun applyColorSpaceTransform("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        inR: Float,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        inG: Float,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        inB: Float,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        cst: CstNodeSettings"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ): Triple<Float, Float, Float> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (!cst.enabled) return Triple(inR, inG, inB)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        var r = inR"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        var g = inG"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        var b = inB"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 1. Color Gamut Matrix Transformation (to Linear Rec.709 space)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        when (cst.inputColorSpace) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            InputColorSpace.DAVINCI_WIDE_GAMUT -> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                // DWG to Rec.709 Chromatic Adaptation Matrix"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val r709 = 1.3460f * r - 0.2556f * g - 0.0904f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val g709 = -0.0545f * r + 1.0512f * g + 0.0033f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val b709 = -0.0014f * r - 0.0441f * g + 1.0455f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                r = r709; g = g709; b = b709"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            InputColorSpace.SAMSUNG_S24_GAMUT -> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                // BT.2020 to Rec.709 Chromatic Adaptation Matrix"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val r709 = 1.6605f * r - 0.5876f * g - 0.0728f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val g709 = -0.1246f * r + 1.1329f * g - 0.0083f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val b709 = -0.0182f * r - 0.1006f * g + 1.1187f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                r = r709; g = g709; b = b709"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            InputColorSpace.ARRI_WIDE_GAMUT_4 -> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val r709 = 1.4312f * r - 0.3228f * g - 0.1084f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val g709 = -0.0612f * r + 1.0824f * g - 0.0212f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val b709 = -0.0098f * r - 0.0734f * g + 1.0832f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                r = r709; g = g709; b = b709"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            InputColorSpace.SONY_SGAMUT3 -> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val r709 = 1.5424f * r - 0.4431f * g - 0.0993f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val g709 = -0.0891f * r + 1.1042f * g - 0.0151f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val b709 = -0.0152f * r - 0.0883f * g + 1.1035f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                r = r709; g = g709; b = b709"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            InputColorSpace.REC709 -> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                // Identity"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Output Color Space re-targeting if target is not Rec.709"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        when (cst.outputColorSpace) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            OutputColorSpace.DCI_P3 -> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val rp3 = 0.8225f * r + 0.1775f * g"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val gp3 = 0.0332f * r + 0.9668f * g"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val bp3 = 0.0171f * r + 0.0724f * g + 0.9105f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                r = rp3; g = gp3; b = bp3"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            OutputColorSpace.REC2020 -> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val r20 = 0.6274f * r + 0.3293f * g + 0.0433f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val g20 = 0.0691f * r + 0.9195f * g + 0.0114f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val b20 = 0.0164f * r + 0.0880f * g + 0.8956f * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                r = r20; g = g20; b = b20"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            OutputColorSpace.REC709, OutputColorSpace.SRGB -> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                // Standard Rec.709 gamut"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 2. DaVinci Tone Mapping Method"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        when (cst.toneMapping) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ToneMappingMethod.DAVINCI -> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                // Saturation-Preserving Luminance Shoulder Roll-Off"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val lum = LR * r + LG * g + LB * b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val knee = cst.kneeThreshold.coerceIn(0.5f, 0.95f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
