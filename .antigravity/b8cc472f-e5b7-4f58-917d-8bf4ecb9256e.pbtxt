            }
            lines {
              text: "    Surface("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        onClick = onClick,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
