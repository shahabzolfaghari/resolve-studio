              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                Row(verticalAlignment = Alignment.CenterVertically) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    // Precision Fine-Tune Mode Toggle (for 10-bit high bitrate adjustments)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    if (allowPrecisionMode) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
