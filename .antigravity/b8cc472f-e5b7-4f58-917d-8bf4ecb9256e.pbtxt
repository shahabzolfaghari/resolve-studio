      thinking_signature: "\022\231\f\n\226\f\001i\024}\023<5S\240\035\223[\025|\345\231 c3\236*`\020L\331\352\335F2J-x>\004\377)<\364\240\030\n{!\317\264m\276\223\222:\346\214\037\\\277\315\333\341\327x\315\327\214Y\032\3052\257\r\"x\210\214\002\331\"\276\220\327\230\276Uuo\032\2021\255\345\267![\366\316\255y\314\227F\357\265\241{[vj\r\221 \377\2253\243\343\254+\233\2247\244\207~\207\027-M\026+*\202I\201eH\267\346\b\347\372\211\366\352G\336o\364\000e\253\223\f\v]\275\366\032\254\356\372\306\310\305j\340\202G&~W\252\035\2620\353\227\240~W\272\227\236\375\355\204C\034\321\327\345p\277Y\003\340\202O\315G8\226[uP\335\334M\334\r\245H\254z*W\207\217\257\307\2517\346D\316Dh%~\233\325\374\233\356\241J\205\006\304\260\030\261\204\327\312UoZ\\Et\372\301\306\372mZ\342\333\335\270\257f?c\206\250T\343u\271\354\313\236\0304>0\240\002i\036wT5\235\021\211\303\210\321\320\177\222\204-:\231\r\270\267\3728\334\335\027\360\225\'a\226\342\334VE\035.\316\270\236\304]\307\302\274\353V\240\305\267\273\213\034s\224Fx\253\343\337\343nB7\023-\215\200M\307\"\264\351\n\\]\317R\212\3737_\000\317\a\'\361\3376\227er\317\320\374\264\267\237\036\352\360\033\226\030\243\363\2351\314\340[\361\351\033\217\361\244t&\253`\200\331\273\315\272F8\270\236\333\310W\332\024\030Oz\216\r\216\262\035\347\274\033\000\033r%\303\035M\016\244*\205/\251\016\255T7\177\320$\325}=\362\032O>\177\224[\3040\033\206\202%n\252\t5\316\237w\305dyly)`1\255\246P`\356\214\227\312\2440r`\'\034\264V^)\364I$\232\300\353\020\373k\363,\241Z\211\331\213\267\310\260\342\206\334k\363j\020\t4\277,\234\3612\311\346\n\355W\265\202g\266\250\002\200\345\323rj\b\357&\303n\277\25594\207\302\236\337\323=\255\344\217\330\336\016\361\207\247\314D{\331_\314\202]o\257e\325\221Qh\336\033\035F1\\\231w\020x\317\352\\\a\'\032\345*<l\020\352w#\276Z\370\207;\23574\325\3037\237\002\352a+>\3566\314Pk\237\257\206g\207\233!a\241wv\a\034\200\351\363a\337w>\245\235\250\307\201\313Q\021\022X\354\225j\372\346\3451\277Am\317\017J\tI\216\317\246\260\336%\316\b/\257O\216\216\347|E\231Y& \372@\025H\016\f\324\372\027)u\232\215\363\273\017\271\276aT\316\000\354\244o\2176\"\271qY\334\037o/3S\323U\300\002\276\262NG\316b]u&<\335<\261\033(\3647\344*A\356R\356\203\330\022\305c\310n~\247\221\tm\236\226\362x\344\363\371\021+\270j\276\"\325{h$\242\251={\313\336\023b\32129\236r\037\266\327\'\205)\0274\266F\247\343\036\231E\201\031Z\300b\243\363\356\245\220z\254\026\371F\366@\032O\236\352a\303V\312\345f\240\000sN\264\036}\006\312\204\251pxz~q\226\334\351\374/\367\355C\362\221l\365k\035\352#\027\235\303Hoze#\215H\373u%\345\"\244\241\306V\212\264\370\253\334\022pl`\204\333\242\036J(\305\033v\3459p\232\2764\310a>\001\222=r\226\026\320kGvw\031.\214l\265\240UZ\306\3329\246i\363A^\330*V\b8}\f]\035\367\330\242\202\260\253\206\301\252\205\3727\235o3\240\253\347\a\031o\335\245\245~\005\b0\335.\312s\2677\300\274\361}cT\0038\021\205}V\030\306L\373\221w\254\022\253\3443/\255<`\030\264!\3546x\202\321\315\020\347\233l\374\243\275\022/\362\006\341\257\266\020\275\031K\340\246\024\037\212[!<U\213\243J\341WF\203\2426\202\tl\f\206\341\250yO\301\225c\3703K\310\026\201\212\264:\3402v\027s 6\231\023\327&\221\330q\325\037\"\306\263\005,\273\006Q\232\006\026BQqu/.g\356\322\367\a\260\024\371\213\3721\2768L[\366^\030\003H/%\tb5\036\020\232 \357>Q\375\372nf\212\0230\347\310\342\323V\322t\\*^\212\a\027\n\352\336q\345\263?\035\376\207\342\377\235\306\316\003\346\337u\334\353\325\270sO\275\330p\265\365\n8M\3115dI\235\360\242\314\365u\322*\200\267\036\275\220~\030W\372k\353!QM\nR\222\206!N\001\257\326B\206\3626\021\242\346\202\232\335\033\354q\342C\2563\220<\221\300\322@\221\225\300%\210E\232y\246\f\202\373vZ\227\354Y\214\037\333\262\034\243V\213L\335/89\"t\375P\264\347\261\222\2655\021\362;n^\300\312\0263G\343\344\327\370\375\311m\250\215>+\341\001\000|\216\214\231\321\372&\313\300\351\313}\035\n\"\301|\264\0223\331\3070}\1774\252\3619\262x\031\350qV\236\372\006+\353\330\201\2256\216Uk\020\263\200\343\n\\\365\316M\237D\254\200\026\377\340\271\334n\300\275\233_\2178X-\200\f\3155q\301\a\225\252aZ\034\366\001J\v<\256\273\272\303\'\030\205j\255\016\f\241\275*V\244\327\242\017\271|\206&4\225\331x1\220\300Pi=\265\305\323\264\233\356\260-1\315\377e,`? gw\213\304\345\211P\001\262k\024\213O~\256\304x\312\234VV-\345_\263\301\306\335\205;\0306\353Bcx\2535M\257\346\206\260>r\211&\3158\215\2129{\347iOq\364\243\316\037\324\250\372c\221:@\233\352\310\020\323x\337g\017x\\TV\246:\021\346\237\005\253+x\237\fzI\362[\204"
