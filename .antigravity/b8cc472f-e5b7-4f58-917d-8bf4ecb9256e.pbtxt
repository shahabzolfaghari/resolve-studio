            }
            lines {
              text: "        tangents[n - 1] = ms[n - 2]"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        for (i in 0 until n - 1) {"
