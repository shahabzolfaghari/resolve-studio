            lines {
              text: "                                HistogramDisplayMode.COMBINED -> \"ALL\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                HistogramDisplayMode.LUMINANCE -> \"LUM\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                HistogramDisplayMode.RGB_PARADE -> \"RGB\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = TextSecondary,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            fontSize = 7.5.sp,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            fontWeight = FontWeight.Bold,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            fontFamily = FontFamily.Monospace,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            modifier = Modifier.padding(horizontal = 4.dp, vertical = 2.dp)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    Spacer(modifier = Modifier.width(3.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // Size Expand/Contract Button"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    IconButton("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        onClick = { isExpanded = !isExpanded },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        modifier = Modifier.size(18.dp).testTag(\"histogram_expand_button\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        Icon("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            imageVector = if (isExpanded) Icons.Default.CloseFullscreen else Icons.Default.OpenInFull,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            contentDescription = \"Resize Histogram Scope\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            tint = TextMuted,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            modifier = Modifier.size(11.dp)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // Close Button"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    IconButton("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        onClick = onClose,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        modifier = Modifier.size(18.dp).testTag(\"close_histogram_overlay_button\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        Icon("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            imageVector = Icons.Default.Close,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            contentDescription = \"Close Histogram Scope\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            tint = TextMuted,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            modifier = Modifier.size(11.dp)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // =========================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // 2. REAL-TIME 256-BIN GRAPH CANAVAS"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // =========================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Box("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                modifier = Modifier"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .fillMaxWidth()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .weight(1f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .clip(RoundedCornerShape(4.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .background(Color(0xFF070A10))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .border(0.5.dp, Color(0xFF1E2838), RoundedCornerShape(4.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                Canvas(modifier = Modifier.fillMaxSize().padding(horizontal = 2.dp, vertical = 2.dp)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val w = size.width"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val h = size.height"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 1. IRE Graticule Grid Lines (0%, 18% Mid-Gray, 50%, 75%, 100%)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val gridFractions = floatArrayOf(0.18f, 0.50f, 0.75f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    for (frac in gridFractions) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        val gx = frac * w"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        drawLine("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = if (frac == 0.18f) ResolveGreen.copy(alpha = 0.35f) else Color(0xFF1E2838),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            start = Offset(gx, 0f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            end = Offset(gx, h),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            strokeWidth = 1.dp.toPx(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            pathEffect = if (frac == 0.18f) PathEffect.dashPathEffect(floatArrayOf(4f, 4f)) else null"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // Max bin sample count for auto-scaling"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    var maxCount = 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    for (i in 0..255) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        if (displayMode == HistogramDisplayMode.LUMINANCE) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            maxCount = maxOf(maxCount, histogram.lumBins[i])"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            maxCount = maxOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                maxCount,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                histogram.redBins[i],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                histogram.greenBins[i],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                histogram.blueBins[i],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                histogram.lumBins[i]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 2. Render Luminance (if LUMA or COMBINED)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    if (displayMode == HistogramDisplayMode.LUMINANCE || displayMode == HistogramDisplayMode.COMBINED) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        val lumPath = Path()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        lumPath.moveTo(0f, h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        for (i in 0..255) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val x = (i / 255f) * w"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val normH = (histogram.lumBins[i].toFloat() / maxCount) * h * 0.94f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            lumPath.lineTo(x, h - normH)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        lumPath.lineTo(w, h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        lumPath.close()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        // Gradient fill under luminance curve"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        drawPath("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            path = lumPath,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            brush = Brush.verticalGradient("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                    Color.White.copy(alpha = if (displayMode == HistogramDisplayMode.LUMINANCE) 0.35f else 0.12f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                    Color.White.copy(alpha = 0.02f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        // Stroke line"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        drawPath("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            path = lumPath,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = Color.White.copy(alpha = if (displayMode == HistogramDisplayMode.LUMINANCE) 0.9f else 0.5f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            style = Stroke(width = 1.2.dp.toPx())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 3. Render RGB Channels (if RGB_PARADE or COMBINED)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    if (displayMode == HistogramDisplayMode.RGB_PARADE || displayMode == HistogramDisplayMode.COMBINED) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        val channels = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            Pair(histogram.redBins, Color(0xFFEF4444)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            Pair(histogram.greenBins, Color(0xFF10B981)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            Pair(histogram.blueBins, Color(0xFF38BDF8))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        for ((bins, channelColor) in channels) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val path = Path()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            path.moveTo(0f, h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            for (i in 0..255) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val x = (i / 255f) * w"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val normH = (bins[i].toFloat() / maxCount) * h * 0.90f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                path.lineTo(x, h - normH)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            path.lineTo(w, h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            path.close()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            drawPath("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                path = path,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                color = channelColor.copy(alpha = 0.15f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            drawPath("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                path = path,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                color = channelColor.copy(alpha = 0.85f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                style = Stroke(width = 1.dp.toPx())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 4. Crushed Black (0 IRE) alert line"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    if (histogram.shadowClipPct > 1.0f) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        drawLine("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = Color(0xFFEF4444),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            start = Offset(1.5f, 0f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            end = Offset(1.5f, h),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            strokeWidth = 3.dp.toPx()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 5. Blown White (100 IRE) alert line"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    if (histogram.highlightClipPct > 1.0f) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        drawLine("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = Color(0xFFEF4444),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            start = Offset(w - 1.5f, 0f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            end = Offset(w - 1.5f, h),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            strokeWidth = 3.dp.toPx()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Spacer(modifier = Modifier.height(2.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // =========================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // 3. TELEMETRY & CLIPPING STATUS BAR"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // =========================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Row("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                verticalAlignment = Alignment.CenterVertically,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                horizontalArrangement = Arrangement.SpaceBetween,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                modifier = Modifier.fillMaxWidth()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                // Exposure Level / Mean IRE"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                Text("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    text = \"EXP ${(histogram.avgLum / 255f * 100).toInt()}%\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    color = TextSecondary,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    fontSize = 7.5.sp,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    fontFamily = FontFamily.Monospace,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    fontWeight = FontWeight.Bold"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                // Clipping Status Indicator"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                when {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    histogram.shadowClipPct > 1.5f && histogram.highlightClipPct > 1.5f -> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        Text("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            text = \"CRUSH & BLOWN\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = Color(0xFFEF4444),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            fontSize = 7.5.sp,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            fontWeight = FontWeight.Black,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
