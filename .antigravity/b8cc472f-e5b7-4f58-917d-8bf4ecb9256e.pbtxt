    content: "\ndata class FilmEffects(\n    val grainIntensity: Float = 0f,       // 0..1\n    val grainSize: Float = 1.0f,          // 0.5..2\n    val halationIntensity: Float = 0f,    // 0..1 (warm red edge glow)\n    val halationRadius: Float = 12f,      // pixel spread\n    val vignetteIntensity: Float = 0f     // 0..1 edge falloff\n) : Serializable\n\nenum class LutPreset(val displayName: String, val description: String) {\n    SAMSUNG_LOG_TO_REC709(\"Samsung Log \342\206\222 Rec.709\", \"Official S24 Ultra 10-bit logarithmic recovery\"),\n    SAMSUNG_CINE_WARM(\"Samsung Cine Warm\", \"Rich cinematic skin tones with amber highlights\"),\n    BLOCKBUSTER_TEAL_ORANGE(\"Blockbuster Teal & Orange\", \"Hollywood punch with complementary color separation\"),\n    CLEAN_COMMERCIAL(\"Clean Commercial\", \"Crisp whites, neutral skin tones, high dynamic contrast\"),\n    FILM_EMULATION_KODAK(\"Kodak 2383 Print\", \"Legendary cinema film print stock with gentle roll-off\"),\n    CUSTOM_CUBE(\"Custom .cube LUT\", \"Imported 3D LUT table\")\n}\n\ndata class ColorGradeSettings(\n    // Primary Wheels\n    val lift: WheelValue = WheelValue(),"
