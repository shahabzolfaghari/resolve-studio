      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Update evaluateMask to handle ELLIPTICAL and RECTANGULAR power windows and showMatte mode in SamsungLogColorScience.kt\",\"EndLine\":191,\"Instruction\":\"Support ELLIPTICAL, RECTANGULAR, and LINEAR masks with smooth feathering\",\"ReplacementContent\":\"        val rawWeight = when (mask.type) {\\n            MaskType.ELLIPTICAL -> {\\n                val rxNorm = rx / mask.radiusX.coerceAtLeast(0.01f)\\n                val ryNorm = ry / mask.radiusY.coerceAtLeast(0.01f)\\n                val dist = sqrt(rxNorm * rxNorm + ryNorm * ryNorm)\\n                val inner = (1.0f - mask.feather).coerceAtLeast(0f)\\n                if (dist <= inner) 1.0f\\n                else if (dist >= 1.0f) 0.0f\\n                else {\\n                    val t = (dist - inner) / (1.0f - inner)\\n                    1.0f - (t * t * (3f - 2f * t)) // Smoothstep\\n                }\\n            }\\n            MaskType.RECTANGULAR -> {\\n                val halfW = mask.radiusX.coerceAtLeast(0.02f)\\n                val halfH = mask.radiusY.coerceAtLeast(0.02f)\\n                val featherW = (halfW * mask.feather).coerceAtLeast(0.005f)\\n                val featherH = (halfH * mask.feather).coerceAtLeast(0.005f)\\n\\n                val qx = abs(rx) - (halfW - featherW)\\n                val qy = abs(ry) - (halfH - featherH)\\n\\n                val dist = maxOf(qx / featherW, qy / featherH)\\n                if (dist <= 0f) 1.0f\\n                else if (dist >= 1.0f) 0.0f\\n                else {\\n                    val t = dist.coerceIn(0f, 1f)\\n                    1.0f - (t * t * (3f - 2f * t)) // Smoothstep\\n                }\\n            }\\n            MaskType.LINEAR -> {\\n                val dist = ry / mask.radiusY.coerceAtLeast(0.01f)\\n                val inner = -mask.feather\\n                val outer = mask.feather\\n                if (dist <= inner) 1.0f\\n                else if (dist >= outer) 0.0f\\n                else {\\n                    val t = (dist - inner) / (outer - inner)\\n                    1.0f - (t * t * (3f - 2f * t))\\n                }\\n            }\\n            MaskType.NONE -> 1.0f\\n        }\\n\\n        val result = if (mask.invert) 1.0f - rawWeight else rawWeight\\n        return result.coerceIn(0f, 1f)\\n    }\",\"StartLine\":164,\"TargetContent\":\"        val rawWeight = when (mask.type) {\\n            MaskType.RADIAL -> {\\n                val dist = sqrt((rx / mask.radiusX).pow(2) + (ry / mask.radiusY).pow(2))\\n                val inner = 1.0f - mask.feather\\n                if (dist <= inner) 1.0f\\n                else if (dist >= 1.0f) 0.0f\\n                else {\\n                    val t = (dist - inner) / (1.0f - inner)\\n                    1.0f - (t * t * (3f - 2f * t)) // Smoothstep\\n                }\\n            }\\n            MaskType.LINEAR -> {\\n                val dist = ry / mask.radiusY\\n                val inner = -mask.feather\\n                val outer = mask.feather\\n                if (dist <= inner) 1.0f\\n                else if (dist >= outer) 0.0f\\n                else {\\n                    val t = (dist - inner) / (outer - inner)\\n                    1.0f - (t * t * (3f - 2f * t))\\n                }\\n            }\\n            MaskType.NONE -> 1.0f\\n        }\\n\\n        val result = if (mask.invert) 1.0f - rawWeight else rawWeight\\n        return result.coerceIn(0f, 1f)\\n    }\",\"TargetFile\":\"/app/src/main/java/com/example/color/SamsungLogColorScience.kt\",\"toolAction\":\"Updating evaluateMask in SamsungLogColorScience.kt\",\"toolSummary\":\"Update evaluateMask for elliptical and rectangular power windows\"}"
