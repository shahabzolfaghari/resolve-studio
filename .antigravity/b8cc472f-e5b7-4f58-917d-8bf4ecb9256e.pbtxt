            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Data Model & Grade State"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `ColorGradeState`: Lift (x, y, lum), Gamma (x, y, lum), Gain (x, y, lum), Offset (x, y, lum), Temperature, Tint, Saturation, Contrast, Highlight Roll-Off, Shadow Lift."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `CurvePoints`: Knot arrays for Master, Red, Green, Blue splines (Catmull-Rom or cubic Bezier interpolation)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `MaskState`: Type (None, Radial, Linear), Center (x, y), Size (width, height), Feather, Invert, Opacity."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `EffectsState`: Film Grain (intensity, size), Halation (spread, threshold, red bias), Vignette (radius, softness)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `LutProfile`: Built-in Samsung Log Rec.709, Samsung Cine, Cinematic Teal & Orange, Golden Hour, Black & White Noir, plus custom imported `.cube` files."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 5. Implementation Steps"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Color Engine Core**: Implement `ColorScience` math module with Samsung Log decoding, Lift/Gamma/Gain matrix, RGB cubic spline curves, 3D LUT cube parser/generator, and halation/grain algorithms."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **DaVinci Resolve Studio UI**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - `PreviewSurface`: Real-time video player with scrubber, timecode, play/pause, and press-to-bypass comparison."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - `ScopesDock`: Live Waveform RGB parade, Vectorscope with skin-tone indicator, and RGB Histogram."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - `ColorWheelsPanel`: 4 interactive trackball wheels with color rings, fine-tuning knobs, and reset buttons."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - `CurvesPanel`: Interactive touch canvas with draggable spline knots for Master, R, G, B channels and Hue vs Saturation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - `LutPanel`: Preset browser with Samsung S24 Ultra Log transforms, thumbnail previews, and `.cube` file import."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - `MaskingPanel`: Power window controls (circle, oval, gradient bar) with visual canvas overlays."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - `EffectsPanel`: Halation, film grain, exposure, and white balance sliders."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Export Engine**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - MP4 Video Renderer with progress dialog and playback verification."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - High-Res Frame Stills export to gallery."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Standard `.cube` 3D LUT exporter for desktop DaVinci Resolve compatibility."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Sample Media & Presets**: Pre-populate high-dynamic-range test scenes showcasing Samsung Log before/after grading."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Verification**: Run `compile_applet` to confirm clean compilation and rock-solid performance."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
