      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Add showHistogramOverlay state and wire to VideoPlayerView and Studio More Menu\",\"Instruction\":\"Add showHistogramOverlay state and wire to VideoPlayerView and Studio More Menu in GradingStudioScreen.kt\",\"ReplacementChunks\":[{\"AllowMultiple\":false,\"EndLine\":80,\"ReplacementContent\":\"    var showPresetManagerDialog by remember { mutableStateOf(false) }\\n    var showMoreMenu by remember { mutableStateOf(false) }\\n    var showHistogramOverlay by remember { mutableStateOf(false) }\\n    val savedPresets by viewModel.savedPresets.collectAsStateWithLifecycle()\",\"StartLine\":76,\"TargetContent\":\"    var showPresetManagerDialog by remember { mutableStateOf(false) }\\n    var showMoreMenu by remember { mutableStateOf(false) }\\n    val savedPresets by viewModel.savedPresets.collectAsStateWithLifecycle()\"},{\"AllowMultiple\":false,\"EndLine\":370,\"ReplacementContent\":\"                            // History Stack\\n                            DropdownMenuItem(\\n                                text = { Text(\\\"History (${historyEntries.size - 1} steps)\\\", color = TextPrimary, fontSize = 12.sp) },\\n                                leadingIcon = { Icon(Icons.Default.History, contentDescription = null, tint = ResolveCyan) },\\n                                onClick = {\\n                                    showMoreMenu = false\\n                                    showHistoryDialog = true\\n                                },\\n                                modifier = Modifier.testTag(\\\"history_button\\\")\\n                            )\\n\\n                            // Real-time Histogram Scope Overlay Toggle\\n                            DropdownMenuItem(\\n                                text = { Text(if (showHistogramOverlay) \\\"Hide Histogram Overlay\\\" else \\\"Show Histogram Scope Overlay\\\", color = TextPrimary, fontSize = 12.sp) },\\n                                leadingIcon = { Icon(Icons.Default.Equalizer, contentDescription = null, tint = ResolveCyan) },\\n                                onClick = {\\n                                    showMoreMenu = false\\n                                    showHistogramOverlay = !showHistogramOverlay\\n                                },\\n                                modifier = Modifier.testTag(\\\"menu_histogram_overlay_toggle\\\")\\n                            )\\n\\n                            // Toggle Dock Mode\",\"StartLine\":350,\"TargetContent\":\"                            // History Stack\\n                            DropdownMenuItem(\\n                                text = { Text(\\\"History (${historyEntries.size - 1} steps)\\\", color = TextPrimary, fontSize = 12.sp) },\\n                                leadingIcon = { Icon(Icons.Default.History, contentDescription = null, tint = ResolveCyan) },\\n                                onClick = {\\n                                    showMoreMenu = false\\n                                    showHistoryDialog = true\\n                                },\\n                                modifier = Modifier.testTag(\\\"history_button\\\")\\n                            )\\n\\n                            // Toggle Dock Mode\"},{\"AllowMultiple\":false,\"EndLine\":425,\"ReplacementContent\":\"                                    showFalseColor = settings.showFalseColor,\\n                                    onToggleFalseColor = {\\n                                        viewModel.updateSettings(\\\"Toggle False Color\\\") { it.copy(showFalseColor = !it.showFalseColor) }\\n                                    },\\n                                    showHistogramOverlay = showHistogramOverlay,\\n                                    onToggleHistogramOverlay = { showHistogramOverlay = !showHistogramOverlay },\\n                                    modifier = Modifier.fillMaxWidth()\",\"StartLine\":418,\"TargetContent\":\"                                    show