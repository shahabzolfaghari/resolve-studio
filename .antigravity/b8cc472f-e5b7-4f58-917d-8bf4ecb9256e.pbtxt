            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (scopeType == ScopeOverlayType.VECTORSCOPE) 135.dp else 105.dp"
