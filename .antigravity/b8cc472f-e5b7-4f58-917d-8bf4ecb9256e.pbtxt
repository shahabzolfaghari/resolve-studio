            }
            lines {
              text: "fun LuminanceWheelSlider("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    lumValue: Float,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
