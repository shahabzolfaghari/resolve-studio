      command {
        instruction: "Embed FilmGrainControls in EffectsPanel with controls for size, roughness, and strength"
        is_edit: true
        file {
          absolute_uri: "file:///app/src/main/java/com/example/ui/components/EffectsPanel.kt"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "            // Section 3: Film Halation, Grain & Vignette\n            Row(verticalAlignment = Alignment.CenterVertically) {\n                Icon(Icons.Default.AutoAwesome, contentDescription = null, tint = ResolveAmber, modifier = Modifier.size(14.dp))\n                Spacer(modifier = Modifier.width(6.dp))\n                Text(\n                    text = \"ANALOG FILM EFFECTS\",\n                    color = TextPrimary,\n                    fontSize = 10.sp,\n                    fontWeight = FontWeight.Bold,\n                    letterSpacing = 0.5.sp\n                )\n            }\n            Spacer(modifier = Modifier.height(4.dp))\n\n            GradeSliderRow(\n                label = \"Halation Glow\",\n                value = settings.effects.halationIntensity,\n                onValueChange = {\n                    onSettingsChange(settings.copy(effects = settings.effects.copy(halationIntensity = it)))\n                },\n                valueRange = 0.0f..1.0f,\n                activeColor = ResolveRed,\n                formatString = \"%.2f\",\n                testTag = \"halation_slider\"\n            )\n\n            GradeSliderRow(\n                label = \"35mm Film Grain\",\n                value = settings.effects.grainIntensity,\n                onValueChange = {\n                    onSettingsChange(settings.copy(effects = settings.effects.copy(grainIntensity = it)))\n                },\n                valueRange = 0.0f..1.0f,\n                activeColor = TextSecondary,\n                formatString = \"%.2f\",\n                testTag = \"grain_slider\"\n            )\n\n            GradeSliderRow(\n                label = \"Vignette\",\n                value = settings.effects.vignetteIntensity,\n                onValueChange = {\n                    onSettingsChange(settings.copy(effects = settings.effects.copy(vignetteIntensity = it)))\n                },\n                valueRange = 0.0f..1.0f,\n                activeColor = Color(0xFF64748B),\n                formatString = \"%.2f\",\n                testTag = \"vignette_slider\"\n            )"
          replacement_content: "            // Section 3: Film Halation, Grain Processor & Vignette\n            Row(verticalAlignment = Alignment.CenterVertically) {\n                Icon(Icons.Default.AutoAwesome, contentDescription = null, tint = ResolveAmber, modifier = Modifier.size(14.dp))\n                Spacer(modifier = Modifier.width(6.dp))\n                Text(\n                    text = \"ANALOG FILM EFFECTS\",\n                    color = TextPrimary,\n                    fontSize = 10.sp,\n                    fontWeight = FontWeight.Bold,\n                    letterSpacing = 0.5.sp\n                )\n            }\n            Spacer(modifier = Modifier.height(4.dp))\n\n            // Dedicated Organic Film Grain Processor\n            FilmGrainControls(\n                grain = settings.effects.grain,\n                onGrainChange = { newGrain ->\n                    onSettingsChange(\n                        settings.copy(\n                            effects = settings.effects.copy(\n                                grain = newGrain,\n                                grainIntensity = if (newGrain.enabled) newGrain.strength else 0f,\n                                grainSize = newGrain.size\n                            )\n                        )\n                    )\n                },\n                modifier = Modifier.fillMaxWidth()\n            )\n\n            Spacer(modifier = Modifier.height(6.dp))\n\n            GradeSliderRow(\n                label = \"Halation Glow\",\n                value = settings.effects.halationIntensity,\n                onValueChange = {\n                    onSettingsChange(settings.copy(effects = settings.effects.copy(halationIntensity = it)))\n                },\n                valueRange = 0.0f..1.0f,\n                activeColor = ResolveRed,\n                formatString = \"%.2f\",\n                testTag = \"halation_slider\"\n            )\n\n            GradeSliderRow(\n                label = \"Vignette\",\n                value = settings.effects.vignetteIntensity,\n                onValueChange = {\n                    onSettingsChange(settings.copy(effects = settings.effects.copy(vignetteIntensity = it)))\n                },\n                valueRange = 0.0f..1.0f,\n                activeColor = Color(0xFF64748B),\n                formatString = \"%.2f\",\n                testTag = \"vignette_slider\"\n            )"
          start_line: 147
          end_line: 196
        }
      }
    }
