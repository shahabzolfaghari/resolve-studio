            }
            lines {
              text: "private fun ScopeTypeTab(label: String, isSelected: Boolean, onClick: () -> Unit) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Surface("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        onClick = onClick,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        color = if (isSelected) ResolveAmber.copy(alpha = 0.25f) else Color.Transparent,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        shape = RoundedCornerShape(3.dp)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        Text("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            text = label,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            color = if (isSelected) ResolveAmber else TextMuted,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            fontSize = 7.5.sp,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            fontWeight = if (isSelected) FontWeight.Black else FontWeight.Normal,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            fontFamily = FontFamily.Monospace,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            modifier = Modifier.padding(horizontal = 4.dp, vertical = 2.dp)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
