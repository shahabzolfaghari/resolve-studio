  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/GradingViewModel.kt"
    start_line: 59
    end_line: 109
    content: "    fun loadScene(scene: SampleScene) {\n        _currentScene.value = scene\n        importedVideoUri = null\n        val raw = SampleMediaGenerator.generateLogFrame(scene, frameIndex = 0)\n        _rawFrameBitmap.value = raw\n        triggerGrade()\n    }\n\n    fun onImportVideoUri(uri: Uri) {\n        viewModelScope.launch(Dispatchers.IO) {\n            try {\n                importedVideoUri = uri\n                val retriever = MediaMetadataRetriever()\n                retriever.setDataSource(getApplication(), uri)\n                val durationStr = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)\n                val durMs = durationStr?.toLongOrNull() ?: 5000L\n                _totalDurationMs.value = durMs\n\n                val frame = retriever.getFrameAtTime(0, MediaMetadataRetriever.OPTION_CLOSEST_SYNC)\n                if (frame != null) {\n                    _rawFrameBitmap.value = frame\n                    triggerGrade()\n                }\n                retriever.release()\n            } catch (e: Exception) {\n                e.printStackTrace()\n            }\n        }\n    }\n\n    fun onImportCubeLut(cubeContent: String) {\n        val parsed = SamsungLogColorScience.parseCubeLut(cubeContent)\n        if (parsed != null) {\n            val (size, data) = parsed\n            updateSettings {\n                it.copy(\n                    activeLut = LutPreset.CUSTOM_CUBE,\n                    customLutSize = size,\n                    customLutData = data\n                )\n            }\n        }\n    }\n\n    fun updateSettings(transform: (ColorGradeSettings) -> ColorGradeSettings) {\n        _gradeSettings.value = transform(_gradeSettings.value)\n        triggerGrade()\n    }\n\n    fun setBypass(bypass: Boolean) {\n        _gradeSettings.value = _gradeSettings.value.copy(bypass = bypass)"
