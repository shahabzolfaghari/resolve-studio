        target_content: "                    // Reset Grade button\n                    IconButton(\n                        onClick = {\n                            viewModel.resetGrade()\n                            Toast.makeText(context, \"Reset all color wheels and curves\", Toast.LENGTH_SHORT).show()\n                        },\n                        modifier = Modifier.size(32.dp).testTag(\"reset_all_grade_button\")\n                    ) {\n                        Icon(Icons.Default.RestartAlt, contentDescription = \"Reset Grade\", tint = TextMuted, modifier = Modifier.size(18.dp))\n                    }\n\n                    Spacer(modifier = Modifier.width(2.dp))\n\n                    // Export Button CTA\n                    Button(\n                        onClick = { showExportDialog = true },\n                        colors = ButtonDefaults.buttonColors(containerColor = ResolveAmber),\n                        contentPadding = PaddingValues(horizontal = 8.dp, vertical = 2.dp),\n                        shape = RoundedCornerShape(6.dp),\n                        modifier = Modifier\n                            .height(28.dp)\n                            .padding(end = 4.dp)\n                            .testTag(\"open_export_dialog_button\")\n                    ) {\n                        Icon(Icons.Default.Share, contentDescription = null, tint = Color(0xFF1E1400), modifier = Modifier.size(12.dp))\n                        Spacer(modifier = Modifier.width(3.dp))\n                        Text(\"EXPORT\", color = Color(0xFF1E1400), fontSize = 10.sp, fontWeight = FontWeight.Black)\n                    }\n                },\n                colors = TopAppBarDefaults.topAppBarColors(containerColor = StudioSurface)\n            )\n        },\n        bottomBar = {\n            // Studio Dock Bottom Navigation\n            StudioDockTabs(\n                activeTab = activeTab,\n                onTabSelected = { activeTab = it },\n                showScopes = showScopes,\n                onToggleScopes = { showScopes = !showScopes },\n                modifier = Modifier\n                    .windowInsetsPadding(WindowInsets.navigationBars)\n                    .padding(horizontal = 6.dp, vertical = 4.dp)\n            )\n        }\n    ) { innerPadding ->"
        replacement_content: "                    // Toggle Dock Presentation Mode (Floating Action Menu vs Static Dock)\n                    IconButton(\n                        onClick = { uiStateManager.toggleDockMode() },\n                        modifier = Modifier.size(32.dp).testTag(\"toggle_dock_mode_button\")\n                    ) {\n                        Icon(\n                            imageVector = if (uiStateManager.dockMode == DockPresentationMode.COLLAPSED_FLOATING)\n                                Icons.Default.Dock else Icons.Default.CloseFullscreen,\n                            contentDescription = if (uiStateManager.dockMode == DockPresentationMode.COLLAPSED_FLOATING)\n                                \"Expand Studio Dock\" else \"Collapse to Floating Menu\",\n                            tint = if (uiStateManager.dockMode == DockPresentationMode.COLLAPSED_FLOATING)\n                                ResolveAmber else TextSecondary,\n                            modifier = Modifier.size(18.dp)\n                        )\n                    }\n\n                    // Reset Grade button\n                    IconButton(\n                        onClick = {\n                            viewModel.resetGrade()\n                            Toast.makeText(context, \"Reset all color wheels and curves\", Toast.LENGTH_SHORT).show()\n                        },\n                        modifier = Modifier.size(32.dp).testTag(\"reset_all_grade_button\")\n                    ) {\n                        Icon(Icons.Default.RestartAlt, contentDescription = \"Reset Grade\", tint = TextMuted, modifier = Modifier.size(18.dp))\n                    }\n\n                    Spacer(modifier = Modifier.width(2.dp))\n\n                    // Export Button CTA\n                    Button(\n                        onClick = { showExportDialog = true },\n                        colors = ButtonDefaults.buttonColors(containerColor = ResolveAmber),\n                        contentPadding = PaddingValues(horizontal = 8.dp, vertical = 2.dp),\n                        shape = RoundedCornerShape(6.dp),\n                        modifier = Modifier\n                            .height(28.dp)\n                            .padding(end = 4.dp)\n                            .testTag(\"open_export_dialog_button\")\n                    ) {\n                        Icon(Icons.Default.Share, contentDescription = null, tint = Color(0xFF1E1400), modifier = Modifier.size(12.dp))\n                        Spacer(modifier = Modifier.width(3.dp))\n                        Text(\"EXPORT\", color = Color(0xFF1E1400), fontSize = 10.sp, fontWeight = FontWeight.Black)\n                    }\n                },\n                colors = TopAppBarDefaults.topAppBarColors(containerColor = StudioSurface)\n            )\n        },\n        bottomBar = {\n            // Studio Dock Bottom Navigation (only visible when in DOCKED mode)\n            if (uiStateManager.dockMode == DockPresentationMode.DOCKED) {\n                StudioDockTabs(\n                    activeTab = activeTab,\n                    onTabSelected = { activeTab = it },\n                    showScopes = showScopes,\n                    onToggleScopes = { showScopes = !showScopes },\n                    modifier = Modifier\n                        .windowInsetsPadding(WindowInsets.navigationBars)\n                        .padding(horizontal = 6.dp, vertical = 4.dp)\n                )\n            }\n        }\n    ) { innerPadding ->"
