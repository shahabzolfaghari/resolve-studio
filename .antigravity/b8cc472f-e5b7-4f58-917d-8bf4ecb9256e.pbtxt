              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            Spacer(modifier = Modifier.height(4.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // =========================================="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // 2. THE INTERACTIVE COLOR WHEEL CANVAS"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // Provides Hue spectrum, saturation vector line, and reticle"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            // Touch-based adjustments: direct tap & responsive trackball drag"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // =========================================="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            Box("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                contentAlignment = Alignment.Center,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                modifier = Modifier"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    .size(wheelDiameter)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    .pointerInput(Unit) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                    .pointerInput(isPrecisionFineTune, value) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        detectTapGestures("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            onTap = { tapOffset ->"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val center = Offset(size.width / 2f, size.height / 2f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val radius = size.minDimension / 2f - 6.dp.toPx()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val maxPuckDist = radius * 0.88f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val dx = (tapOffset.x - center.x) / maxPuckDist"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val dy = -(tapOffset.y - center.y) / maxPuckDist // Inverted Y for screen coordinates"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val dist = sqrt(dx * dx + dy * dy)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                if (dist > 1f) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                    onValueChange(value.copy(x = (dx / dist).coerceIn(-1f, 1f), y = (dy / dist).coerceIn(-1f, 1f)))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                    onValueChange(value.copy(x = dx.coerceIn(-1f, 1f), y = dy.coerceIn(-1f, 1f)))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            onDoubleTap = {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                onValueChange(value.copy(x = 0f, y = 0f))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    .pointerInput(isPrecisionFineTune, value) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        detectDragGestures { change, dragAmount ->"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            change.consume()"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            // High-bitrate precision sensitivity: 0.005f vs normal 0.015f"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                            val sensitivity = if (isPrecisionFineTune) 0.004f else role.defaultSensitivity"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                            // High-bitrate precision sensitivity: 0.0035f vs normal 0.015f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val sensitivity = if (isPrecisionFineTune) 0.0035f else role.defaultSensitivity"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val newX = (value.x + dragAmount.x * sensitivity).coerceIn(-1f, 1f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            val newY = (value.y - dragAmount.y * sensitivity).coerceIn(-1f, 1f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            val dist = sqrt(newX * newX + newY * newY)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            if (dist > 1f) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                onValueChange(value.copy(x = newX / dist, y = newY / dist))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
