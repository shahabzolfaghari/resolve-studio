              text: "                            Text(\"SHADOW CRUSH ${histogram.shadowClipPct.toInt()}%\", color = Color(0xFFEF4444), fontSize = 7.5.sp, fontWeight = FontWeight.Bold, fontFamily = FontFamily.Monospace)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
