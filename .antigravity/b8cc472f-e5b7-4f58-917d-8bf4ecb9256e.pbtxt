      thinking_signature: "\022\306\025\n\303\025\001i\024}\023~P\r\377\3452\263v\303\356\357\227\235\376\266\"\243p\316\324\202\020\204z4C~\325\217\b\202\344\276\211\030)p\"}\373\216\362\2528\265\237s\035\200t\255\273\026u\316J\365\325\312jX\n\277Il\265@\321\367\257\017`\272\270\300\0002\374\353\326E\346-\032Z\233\'P7\361\006\330\270#\250\356{\033\372\375tvJ\354H\301Ty\335\355U\270l\245\231dL\261Wl<\2568\333\206\255\325\246Rl\273\336.3a\260\024\000\'\254L\027t\270m_\v\216y1\252j\314\231pw\276J\324A\024\217ZO\306:\000\0250F\243\2230$\031j\366\n\337]|\253\234\371|\340\002\241s\006:|c\227f\004\"\357@\317\347\374\f\370\256U\034\214(\030\204\023\202\033\224\352\266}ZOU\261\243&\226\360\224\375\264n\217N\341\242\254\240i\021$k.2\321\354\214Yb\330\207\034h\3159\023\2422\b\256j\0243\224\365\337\b\310\034\f\355G\304\234\265\243\216\177\235\001\242{\227\330`C\273\242\320GX\345\226Sm\f\377.\377\262D\270\240\n88)\033(\t\001R\353\271G\264\231X1\205\256\vK\323\274\246:\344\312\334+\025\211]\206N\r\242\367\370\355E\f\300S\235\375\350\265ulrq\265\362\203\347\375\206\207\252\355\263\302\337\246\346\324\227\237\253H\212\317\030or7o\265\366\221\r\355\260\"_|\005yH<Z,\026>.\215(\031\024\304\274\r\031\245o`Zl\273\t\320\247&\3142\\\237\262;\023\203\ba\261\004W\"\230\030\363U\373~Y\245\310A\2700\220\274\350?\233aWv\210 \217\a\321\304\005[\001\225\n\233\326>1\005\2237z\a\377\226mCt\024\375\346\310\372\331\2737\002\257N\216\t\321\330\216\313\337\346@Mp\343m&\2650d\247w\020Q2v G\313\307\021\254ztK\251\257\230@\202]\231\017\305\370\205p\f\270\303cT\377\237j\005\212t1hq\212\234\256\373\344\371\a\350\2514\227\031r\ta\314\330\210\203\366\335\330\300fY\3449 u\265\3761\035\215\004 \337\213T\310\242S\254\261\032/\212\251G\262\216~\aS;\211\312\206T\250\004\311rk|\032\025b\245\277\216\037\336\331|\374\033\337n\365\245\335S5$\365Q\376~|/L\240\224+9\210\261P\253\266z\337\254QSyw\304Sm\251{\353\300\\\270u\365\023R\243\273\201\323\236\261\231\207\024\313\201\221\213?\367\2776\351Q\264\317Y\230\005w\r\0022\035\271\232\233h\242nf\205-\376\034\211\207\"\243+D 0P\005!\235S=5\'.Z@\202\310f{&?I\350\332\325\371\211\016\245\345a\302\016f\376\263 \352\222,\317\213\227g\3345\215\367,3\275=\303\336?&\"\265b\212\231\274\357\324\352\264\240n\366\366\357,P\313\337\'\001\332\350\343\335\027M\355\250=\321D\207\356\214\0068\360\236X\001\002:oW\205\224\320\354\347sT\200\027b\346/k]\021\337\300\352\307\350\253\267\3071\351V\025T\024*\034\373F\035\341o\371\216\177v\r\255\307\227l\254,\364\223dB\036r\024\364!}\337g\335\306j\276p\220\360\271\a\031=\307\006{\352x\230\274\331\004\244N\223\306\226\307\016\275\257\313\252\v\016\217\237\002\252\351_6\266\366\240xYI\366\257\235}\263\361\224\247\345\t\374\3251R\204 \033\363\275\311\001\"T\321\224\376\227\243\236\352C\025\334\242\225P\035\256q\332^\254\r\230\261\r\v\224\310,\254\212<\tF\033\201\322\337\335\237\000V\235\2058\325kJ$\3330\240M\363X\23525u\213\331\364*~i\356f]\320\263\315\267@$\374k\340\217\323\302r\025\300\377\024[\347\236p?W\006}\347~\247\035\215\361o\305\336\211\257\255\245\031\036\027l\306\037\274\324|N\027+\347\226$\350\274\231\315A\vP\222\n\020\341g\003\021gK\234\370F\242\346\227\375\227\217\210\001QZ2\036\307\"h S\352\270\232a\257I\234\240\363\037\203\027+\353\363\377\0363\177\210,\034!\177\213\307\206\317Q\317\"\311\032\210\354\336T?]D\332(\364E=o&\337@R\363\311eersr\372j>\017z7\0014\244T\327\357\245\256\213\360\340\307v\306\230\351\306i\306m\262\004\nC\310\341\252\277\327.7\224{\357\271\371\333\rjV1CP9h1\265Rx^p\2622y\314\337Jq\231\024\a\030\321\370\301\205\230\\C>Z{\215tj\326\345\004\333e\340I\215G\264\262gv\350\227wo\332F\325\206Jk\021\271M\223<\223 \233\234Q\300W8\246Je\334\030X\303VL\322\b\b\262\2524{mz\346\252Y@rjK\267\360Zt\0041\006\336@\004\316-\276\026\250\277\376\362cD\264;\226\244z\b\265\306\326\240\202\020\027\016\333F\307\265\201k\303Q\347\336\375\276m\376?a\bw\317@5\271\036\376\264\027\215S\205\340\314\263v\264\341\'\205%\356Y\206c\023Vb`H\232R\266\032\247\203\220F\254\207m{\"w\243/My*\332\216\360\361\016\374