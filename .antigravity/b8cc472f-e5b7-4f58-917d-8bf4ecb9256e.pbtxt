      thinking_signature: "\022\267\023\n\264\023\001i\024}\023qN\247\2717\263\v\216\322\204\n\365K\347\312l\301\241\204\212\346\337\244\216\"\327\232\atnY\314\265\207\025\371\370\2556\247C\021I\332\261\205J=9\257h\240\254\036\035\265\320\001I\204r@D\276\245&\001\033j\274\375\306\313\016\"\202\204BP\252\222y]\272\275#\023\241\264\240\312\315\177\227F\\n\254~\035\177\bJ~\203e$^\200\342\272\"\374\215\0349o2\204\237\232\022\254t\317\325QNw\bw\350\202E\254\241p\022F|\"\365\372\272a\3728@\215\244\253\272\257Y\247^?\n<\026\276\243;y3\216bH\3044O\201\232\022=\"\307;\2475Z\323\253^\333\b8\212\303\304\300qYwv\357y\325]PF\025T:2<\037\312+\246^eG\036\353\251\261w\246)C\245\001\214\354AQ\033c\343\373\320&\345\200\016\314\277\343\316\246s\2456\352\267\315C\302\200\357\206\341\217d\005t]\364\271\027\303G\333\240\021a\333j\3271\\\375\212\252\200o\035pz\004BI\313\020\322\202\330\253\n1)\026U\236\216\345:\362=\317\207\265$\004\337o\372\225\371\373!\351C|\351\233v={\240\327\220\177a\016>7\275\260\3228I\346$D\376\v\220\221}\272w\212\336\031M\021o\264\261\027\3413t\267&\3447\350\270t\235\240\340\266\330\000\343#;\203\2154\262\315\004\270M\265V\275)C~\002w\206H\231A[\333\"]\374\344\225\312\351ar\363\240\245\272\023Hx\262\0323\375\224M\346!go\323I\267\310\031\335^\325|\006A\330\221A\374/RX@\2461:\366\273\2442\277x\031\021\257h\177\367\240\264\177[\006[\302k\376\304\031M\355\361\n\342\271\210\245<}\v\026\244sN\a\306\315\304\221_&\324\310\353\376\005\004\017\030\344i\373G\306\240\212\310\022{\023k>\375\177\262Y\330\016\342\006ym\357WRI\313\341B\354.\2473\331\331\315\352\325x)\346\375z\246\256\371\002-z\240\265\337p=e\004=\031\362Rc\233n\3216Vb\206:5\v|&\206\234\375[\244\031\235\334\266\0327\210\232\226\223\223P\003\"fB\202\326\317)o\270\213\037\236\177\333_\265\305p\nj\222\026\204\326\033\030RM:C\216\242>\325\375\234\342\352\336\376\324\355\366\326\356L\202\237\000\rO\304I\345\036s&t\365\034\364hn\251-1<\026.9\345\267@1\377a-\376\354\021\024K4\311y\201oQd\022\276-0\222B3\316\016YF\237P\371