    }
    command_line: "python3 -c \'\nimport os, math\nfrom PIL import Image, ImageDraw\n\ndef create_icons():\n    # Render 512x512 master icon\n    size = 512\n    img = Image.new(\"RGBA\", (size, size), (22, 26, 34, 255))\n    draw = ImageDraw.Draw(img)\n\n    # Draw dark background subtle rings\n    for r in [200, 150, 100]:\n        draw.ellipse([size/2 - r, size/2 - r, size/2 + r, size/2 + r], outline=(35, 45, 60, 255), width=2)\n\n    # Draw 6 color segments (Color Wheel)\n    center = (size/2, size/2)\n    outer_r = 160\n    inner_r = 95\n    colors = [\n        (239, 68, 68),    # Red\n        (251, 191, 36),   # Yellow\n        (16, 185, 129),   # Green\n        (6, 182, 212),    # Cyan\n        (59, 130, 246),   # Blue\n        (236, 72, 153)    # Magenta\n    ]\n\n    for i in range(6):\n        start_angle = i * 60 - 30\n        end_angle = (i + 1) * 60 - 30\n        # Draw arc segments\n        draw.pieslice([center[0]-outer_r, center[1]-outer_r, center[0]+outer_r, center[1]+outer_r],\n                      start=start_angle, end=end_angle, fill=colors[i])\n\n    # Inner cutout circle for trackball\n    draw.ellipse([center[0]-inner_r, center[1]-inner_r, center[0]+inner_r, center[1]+inner_r], fill=(30, 36, 48, 255))\n    # Center reticle ring\n    draw.ellipse([center[0]-40, center[1]-40, center[0]+40, center[1]+40], fill=(20, 24, 32, 255), outline=(100, 116, 139, 255), width=3)\n    # Center amber indicator\n    draw.ellipse([center[0]-16, center[1]-16, center[0]+16, center[1]+16], fill=(245, 158, 11, 255))\n\n    # Crosshair ticks\n    draw.line([center[0]-32, center[1], center[0]-18, center[1]], fill=(148, 163, 184, 255), width=3)\n    draw.line([center[0]+18, center[1], center[0]+32, center[1]], fill=(148, 163, 184, 255), width=3)\n    draw.line([center[0], center[1]-32, center[0], center[1]-18], fill=(148, 163, 184, 255), width=3)\n    draw.line([center[0], center[1]+18, center[0], center[1]+32], fill=(148, 163, 184, 255), width=3)\n\n    specs = {\"mdpi\": 48, \"hdpi\": 72, \"xhdpi\": 96, \"xxhdpi\": 144, \"xxxhdpi\": 192}\n    base = \"app/src/main/res\"\n\n    for folder, dim in specs.items():\n        out_dir = os.path.join(base, f\"mipmap-{folder}\")\n        os.makedirs(out_dir, exist_ok=True)\n        # Square\n        sq = img.resize((dim, dim), Image.Resampling.LANCZOS)\n        sq.save(os.path.join(out_dir, \"ic_launcher.png\"), \"PNG\")\n        # Round\n        mask = Image.new(\"L\", (dim, dim), 0)\n        mask_draw = ImageDraw.Draw(mask)\n        mask_draw.ellipse([0, 0, dim, dim], fill=255)\n        round_img = sq.copy()\n        round_img.putalpha(mask)\n        round_img.save(os.path.join(out_dir, \"ic_launcher_round.png\"), \"PNG\")\n\n        # Remove webp if exists\n        for f in [\"ic_launcher.webp\", \"ic_launcher_round.webp\"]:\n            p = os.path.join(out_dir, f)\n            if os.path.exists(p):\n                os.remove(p)\n\ncreate_icons()\nprint(\"Icons successfully generated!\")\n\'"
    proposed_command_line: "python3 -c \'\nimport os, math\nfrom PIL import Image, ImageDraw\n\ndef create_icons():\n    # Render 512x512 master icon\n    size = 512\n    img = Image.new(\"RGBA\", (size, size), (22, 26, 34, 255))\n    draw = ImageDraw.Draw(img)\n\n    # Draw dark background subtle rings\n    for r in [200, 150, 100]:\n        draw.ellipse([size/2 - r, size/2 - r, size/2 + r, size/2 + r], outline=(35, 45, 60, 255), width=2)\n\n    # Draw 6 color segments (Color Wheel)\n    center = (size/2, size/2)\n    outer_r = 160\n    inner_r = 95\n    colors = [\n        (239, 68, 68),    # Red\n        (251, 191, 36),   # Yellow\n        (16, 185, 129),   # Green\n        (6, 182, 212),    # Cyan\n        (59, 130, 246),   # Blue\n        (236, 72, 153)    # Magenta\n    ]\n\n    for i in range(6):\n        start_angle = i * 60 - 30\n        end_angle = (i + 1) * 60 - 30\n        # Draw arc segments\n        draw.pieslice([center[0]-outer_r, center[1]-outer_r, center[0]+outer_r, center[1]+outer_r],\n                      start=start_angle, end=end_angle, fill=colors[i])\n\n    # Inner cutout circle for trackball\n    draw.ellipse([center[0]-inner_r, center[1]-inner_r, center[0]+inner_r, center[1]+inner_r], fill=(30, 36, 48, 255))\n    # Center reticle ring\n    draw.ellipse([center[0]-40, center[1]-40, center[0]+40, center[1]+40], fill=(20, 24, 32, 255), outline=(100, 116, 139, 255), width=3)\n    # Center amber indicator\n    draw.ellipse([center[0]-16, center[1]-16, center[0]+16, center[1]+16], fill=(245, 158, 11, 255))\n\n    # Crosshair ticks\n    draw.line([center[0]-32, center[1], center[0]-18, center[1]], fill=(148, 163, 184, 255), width=3)\n    draw.line([center[0]+18, center[1], center[0]+32, center[1]], fill=(148, 163, 184, 255), width=3)\n    draw.line([center[0], center[1]-32, center[0], center[1]-18], fill=(148, 163, 184, 255), width=3)\n    draw.line([center[0], center[1]+18, center[0], center[1]+32], fill=(148, 163, 184, 255), width=3)\n\n    specs = {\"mdpi\": 48, \"hdpi\": 72, \"xhdpi\": 96, \"xxhdpi\": 144, \"xxxhdpi\": 192}\n    base = \"app/src/main/res\"\n\n    for folder, dim in specs.items():\n        out_dir = os.path.join(base, f\"mipmap-{folder}\")\n        os.makedirs(out_dir, exist_ok=True)\n        # Square\n        sq = img.resize((dim, dim), Image.Resampling.LANCZOS)\n        sq.save(os.path.join(out_dir, \"ic_launcher.png\"), \"PNG\")\n        # Round\n        mask = Image.new(\"L\", (dim, dim), 0)\n        mask_draw = ImageDraw.Draw(mask)\n        mask_draw.ellipse([0, 0, dim, dim], fill=255)\n        round_img = sq.copy()\n        round_img.putalpha(mask)\n        round_img.save(os.path.join(out_dir, \"ic_launcher_round.png\"), \"PNG\")\n\n        # Remove webp if exists\n        for f in [\"ic_launcher.webp\", \"ic_launcher_round.webp\"]:\n            p = os.path.join(out_dir, f)\n            if os.path.exists(p):\n                os.remove(p)\n\ncreate_icons()\nprint(\"Icons successfully generated!\")\n\'"
