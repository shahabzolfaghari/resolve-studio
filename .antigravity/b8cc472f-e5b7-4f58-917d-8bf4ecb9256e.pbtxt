              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                .height(26.dp)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                .clip(RoundedCornerShape(6.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                .background(Color(0xFF10131A))"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                .background(Color(0xFF0F1218))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                .border(0.8.dp, Color(0xFF1E2636), RoundedCornerShape(6.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                .pointerInput(Unit) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    detectDragGestures { change, dragAmount ->"
