    content: "                    .padding(horizontal = 6.dp, vertical = 4.dp)\n            )\n        }\n    ) { innerPadding ->\n        Column(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(innerPadding)\n                .verticalScroll(rememberScrollState())\n        ) {\n            // 1. Video Player Viewport\n            VideoPlayerView(\n                gradedBitmap = gradedBitmap,\n                rawBitmap = rawBitmap,\n                isPlaying = isPlaying,\n                currentTimeMs = currentTimeMs,\n                totalDurationMs = totalDurationMs,\n                mask = settings.mask,\n                showMaskGuide = activeTab == StudioToolTab.MASK,\n                onMaskChange = { newMask -> viewModel.updateSettings { it.copy(mask = newMask) } },\n                onPlayPauseToggle = { viewModel.togglePlayPause() },\n                onSeek = { viewModel.seekTo(it) },\n                onStepFrame = { viewModel.stepFrame(it) },\n                onBypassPress = { viewModel.setBypass(it) }\n            )\n\n            // 2. Collapsible Broadcast Scopes Dock\n            AnimatedVisibility(\n                visible = showScopes,\n                enter = fadeIn(),\n                exit = fadeOut()\n            ) {\n                ScopesView(\n                    previewBitmap = gradedBitmap,\n                    modifier = Modifier.fillMaxWidth()\n                )\n            }\n\n            Spacer(modifier = Modifier.height(4.dp))\n\n            // 3. Active Studio Tool Dock Content\n            when (activeTab) {\n                StudioToolTab.WHEELS -> {\n                    // DaVinci Resolve 4 Primary Wheels: Lift, Gamma, Gain, Offset\n                    Column(modifier = Modifier.fillMaxWidth()) {\n                        Row(\n                            horizontalArrangement = Arrangement.SpaceBetween,\n                            verticalAlignment = Alignment.CenterVertically,\n                            modifier = Modifier.fillMaxWidth().padding(horizontal = 8.dp, vertical = 2.dp)\n                        ) {\n                            Text(\n                                text = \"PRIMARY COLOR WHEELS\",\n                                color = TextPrimary,\n                                fontSize = 11.sp,\n                                fontWeight = FontWeight.Bold,\n                                letterSpacing = 1.sp\n                            )\n                            Text(\n                                text = \"Swipe wheels \342\200\242 Double tap to center\",\n                                color = TextMuted,\n                                fontSize = 9.sp\n                            )\n                        }\n\n                        // Horizontal Scroll for 4 Wheels\n                        Row(\n                            modifier = Modifier\n                                .fillMaxWidth()\n                                .horizontalScroll(rememberScrollState())\n                                .padding(horizontal = 4.dp)\n                        ) {\n                            ColorWheel(\n                                title = \"Lift\",\n                                accentColor = WheelLiftColor,\n                                value = settings.lift,\n                                onValueChange = { newLift -> viewModel.updateSettings { it.copy(lift = newLift) } },\n                                modifier = Modifier.width(160.dp)\n                            )\n\n                            ColorWheel(\n                                title = \"Gamma\",\n                                accentColor = WheelGammaColor,\n                                value = settings.gamma,\n                                onValueChange = { newGamma -> viewModel.updateSettings { it.copy(gamma = newGamma) } },\n                                modifier = Modifier.width(160.dp)\n                            )\n\n                            ColorWheel(\n                                title = \"Gain\",\n                                accentColor = WheelGainColor,\n                                value = settings.gain,\n                                onValueChange = { newGain -> viewModel.updateSettings { it.copy(gain = newGain) } },\n                                modifier = Modifier.width(160.dp)\n                            )\n\n                            ColorWheel(\n                                title = \"Offset\",\n                                accentColor = WheelOffsetColor,\n                                value = settings.offset,\n                                onValueChange = { newOffset -> viewModel.updateSettings { it.copy(offset = newOffset) } },\n                                modifier = Modifier.width(160.dp)\n                            )\n                        }\n                    }\n                }\n\n                StudioToolTab.CURVES -> {\n                    // Custom Spline Curves Editor\n                    CurvesEditor(\n                        curves = settings.curves,\n                        onCurvesChange = { newCurves -> viewModel.updateSettings { it.copy(curves = newCurves) } },\n                        modifier = Modifier.fillMaxWidth()\n                    )\n                }\n\n                StudioToolTab.LUTS -> {\n                    // 3D LUT Browser & Importer\n                    LutPresetBrowser(\n                        selectedLut = settings.activeLut,\n                        lutIntensity = settings.lutIntensity,\n                        onLutChange = { newLut -> viewModel.updateSettings { it.copy(activeLut = newLut) } },\n                        onIntensityChange = { newInt -> viewModel.updateSettings { it.copy(lutIntensity = newInt) } },\n                        onImportCubeClick = { cubeFileLauncher.launch(arrayOf(\"*/*\")) },\n                        modifier = Modifier.fillMaxWidth()\n                    )\n                }\n\n                StudioToolTab.MASK -> {\n                    // Power Window Controls\n                    PowerWindowControls(\n                        mask = settings.mask,\n                        onMaskChange = { newMask -> viewModel.updateSettings { it.copy(mask = newMask) } },\n                        modifier = Modifier.fillMaxWidth()\n                    )\n                }\n\n                StudioToolTab.EFFECTS -> {\n                    // Effects & Film Look\n                    EffectsPanel(\n                        settings = settings,\n                        onSettingsChange = { newSettings -> viewModel.updateSettings { newSettings } },\n                        modifier = Modifier.fillMaxWidth()\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.height(16.dp))\n        }\n    }\n\n    // Export Modal Dialog\n    if (showExportDialog) {\n        ExportDialog(\n            isExporting = isExporting,\n            exportProgress = exportProgress,\n            statusMessage = exportStatusMessage,"
