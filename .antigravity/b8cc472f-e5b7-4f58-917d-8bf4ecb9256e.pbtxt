            }
            lines {
              text: "     * Samsung Log uses a piecewise logarithmic formulation:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "     * for y <= cut: y / slope"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
