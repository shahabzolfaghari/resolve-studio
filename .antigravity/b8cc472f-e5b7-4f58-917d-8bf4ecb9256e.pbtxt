            }
            lines {
              text: "@Composable"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "private fun HistogramOverlayCanvas("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    histogram: com.example.color.SamsungLogColorScience.HistogramResult,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    displayMode: HistogramDisplayMode"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ") {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Canvas(modifier = Modifier.fillMaxSize().padding(horizontal = 2.dp, vertical = 2.dp)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val w = size.width"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val h = size.height"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 1. IRE Graticule Grid Lines (0%, 18% Mid-Gray, 50%, 75%, 100%)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val gridFractions = floatArrayOf(0.18f, 0.50f, 0.75f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for (frac in gridFractions) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            val gx = frac * w"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drawLine("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                color = if (frac == 0.18f) ResolveGreen.copy(alpha = 0.35f) else Color(0xFF1E2838),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                start = Offset(gx, 0f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                end = Offset(gx, h),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                strokeWidth = 1.dp.toPx(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                pathEffect = if (frac == 0.18f) PathEffect.dashPathEffect(floatArrayOf(4f, 4f)) else null"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Max bin sample count for auto-scaling"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        var maxCount = 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for (i in 0..255) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (displayMode == HistogramDisplayMode.LUMINANCE) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                maxCount = maxOf(maxCount, histogram.lumBins[i])"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                maxCount = maxOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    maxCount,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    histogram.redBins[i],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    histogram.greenBins[i],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    histogram.blueBins[i],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    histogram.lumBins[i]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 2. Render Luminance (if LUMA or COMBINED)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (displayMode == HistogramDisplayMode.LUMINANCE || displayMode == HistogramDisplayMode.COMBINED) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            val lumPath = Path()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            lumPath.moveTo(0f, h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            for (i in 0..255) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val x = (i / 255f) * w"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val normH = (histogram.lumBins[i].toFloat() / maxCount) * h * 0.94f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                lumPath.lineTo(x, h - normH)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            lumPath.lineTo(w, h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            lumPath.close()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drawPath("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                path = lumPath,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                brush = Brush.verticalGradient("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        Color.White.copy(alpha = if (displayMode == HistogramDisplayMode.LUMINANCE) 0.35f else 0.12f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        Color.White.copy(alpha = 0.02f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drawPath("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                path = lumPath,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                color = Color.White.copy(alpha = if (displayMode == HistogramDisplayMode.LUMINANCE) 0.9f else 0.5f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                style = Stroke(width = 1.2.dp.toPx())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 3. Render RGB Channels (if RGB_PARADE or COMBINED)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (displayMode == HistogramDisplayMode.RGB_PARADE || displayMode == HistogramDisplayMode.COMBINED) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            val channels = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                Pair(histogram.redBins, Color(0xFFEF4444)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                Pair(histogram.greenBins, Color(0xFF10B981)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                Pair(histogram.blueBins, Color(0xFF38BDF8))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            for ((bins, channelColor) in channels) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val path = Path()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                path.moveTo(0f, h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                for (i in 0..255) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val x = (i / 255f) * w"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val normH = (bins[i].toFloat() / maxCount) * h * 0.90f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    path.lineTo(x, h - normH)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                path.lineTo(w, h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                path.close()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drawPath(path = path, color = channelColor.copy(alpha = 0.15f))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drawPath(path = path, color = channelColor.copy(alpha = 0.85f), style = Stroke(width = 1.dp.toPx()))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 4. Crushed Black (0 IRE) alert line"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (histogram.shadowClipPct > 1.0f) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drawLine(color = Color(0xFFEF4444), start = Offset(1.5f, 0f), end = Offset(1.5f, h), strokeWidth = 3.dp.toPx())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 5. Blown White (100 IRE) alert line"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (histogram.highlightClipPct > 1.0f) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drawLine(color = Color(0xFFEF4444), start = Offset(w - 1.5f, 0f), end = Offset(w - 1.5f, h), strokeWidth = 3.dp.toPx())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "@Composable"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "private fun VectorscopeOverlayCanvas(bitmap: Bitmap) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Canvas(modifier = Modifier.fillMaxSize().padding(3.dp)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val w = size.width"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val h = size.height"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val center = Offset(w / 2f, h / 2f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val radius = (minOf(w, h) / 2f) - 4.dp.toPx()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 1. Polar grid rings (75% broadcast safe, 100% legal limit)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        drawCircle(color = Color(0xFF263248), radius = radius, center = center, style = Stroke(width = 1.dp.toPx()))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        drawCircle(color = Color(0xFF1C2434), radius = radius * 0.75f, center = center, style = Stroke(width = 1.dp.toPx()))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 2. Center crosshairs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        drawLine(color = Color(0xFF222B3B), start = Offset(center.x - radius, center.y), end = Offset(center.x + radius, center.y), strokeWidth = 1.dp.toPx())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        drawLine(color = Color(0xFF222B3B), start = Offset(center.x, center.y - radius), end = Offset(center.x, center.y + radius), strokeWidth = 1.dp.toPx())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 3. Skin Tone Indicator Line (\"I-Bar\" at angle ~123 degrees)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val skinAngleRad = Math.toRadians(123.0).toFloat()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val skinEndX = center.x + cos(skinAngleRad) * radius * 0.92f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val skinEndY = center.y - sin(skinAngleRad) * radius * 0.92f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        drawLine("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            color = ResolveAmber,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            start = center,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            end = Offset(skinEndX, skinEndY),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            strokeWidth = 1.5.dp.toPx()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 4. Target Color Boxes (Red, Green, Blue, Cyan, Magenta, Yellow)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val targets = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Triple(Color(0xFFEF4444), 103f, \"R\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Triple(Color(0xFFEC4899), 60f, \"Mg\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Triple(Color(0xFF3B82F6), 347f, \"B\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Triple(Color(0xFF06B6D4), 283f, \"Cy\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Triple(Color(0xFF10B981), 241f, \"G\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Triple(Color(0xFFFBBF24), 167f, \"Yl\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for ((col, angle, _) in targets) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            val rad = Math.toRadians(angle.toDouble()).toFloat()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            val bx = center.x + cos(rad) * radius * 0.75f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            val by = center.y - sin(rad) * radius * 0.75f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drawRect("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                color = col,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                topLeft = Offset(bx - 2.5.dp.toPx(), by - 2.5.dp.toPx()),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                size = androidx.compose.ui.geometry.Size(5.dp.toPx(), 5.dp.toPx()),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                style = Stroke(width = 0.9.dp.toPx())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 5. Sample bitmap chroma pixels"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val step = 14"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val bmpW = bitmap.width"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val bmpH = bitmap.height"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        val pixels = IntArray(bmpW * bmpH)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        bitmap.getPixels(pixels, 0, bmpW, 0, 0, bmpW, bmpH)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for (y in 0 until bmpH step step) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            val row = y * bmpW"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            for (x in 0 until bmpW step step) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val p = pixels[row + x]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val r = (p shr 16 and 0xFF) / 255f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val g = (p shr 8 and 0xFF) / 255f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val b = (p and 0xFF) / 255f"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                // Cb, Cr chrominance coordinates"
