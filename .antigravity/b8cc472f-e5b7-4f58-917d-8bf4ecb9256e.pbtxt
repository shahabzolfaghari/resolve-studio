            }
            lines {
              text: "        sb.append(\"DOMAIN_MAX 1.0 1.0 1.0\\n\\n\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val step = 1.0f / (lutSize - 1)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val dummyBmp = Bitmap.createBitmap(1, 1, Bitmap.Config.ARGB_8888)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        for (bIdx in 0 until lutSize) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            val inB = bIdx * step"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
