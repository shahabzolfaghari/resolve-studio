              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            val newRy = (mask.radiusY - dy).coerceIn(0.05f, 0.5f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            onMaskChange(mask.copy(radiusY = newRy))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        DragHandle.HANDLE_TOP_RIGHT, DragHandle.HANDLE_BOTTOM_RIGHT,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        DragHandle.HANDLE_TOP_LEFT, DragHandle.HANDLE_BOTTOM_LEFT -> {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
