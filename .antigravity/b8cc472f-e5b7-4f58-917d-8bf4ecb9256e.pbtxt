  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/components/StudioDockContainer.kt"
    start_line: 239
    end_line: 324
    content: "                    }\n                }\n            }\n\n            // ==========================================\n            // 3. COLOR GRADING TOOLS SECTION\n            // (Visible in SPLIT_SCOPE and FULL_TOOL modes)\n            // ==========================================\n            AnimatedVisibility(\n                visible = monitorMode != DockMonitorMode.FULL_SCOPES,\n                enter = expandVertically() + fadeIn(),\n                exit = shrinkVertically() + fadeOut()\n            ) {\n                Column(modifier = Modifier.fillMaxWidth()) {\n                    when (activeTab) {\n                        StudioToolTab.WHEELS -> {\n                            // Primary Color Wheels Deck\n                            Column(modifier = Modifier.fillMaxWidth()) {\n                                Row(\n                                    horizontalArrangement = Arrangement.SpaceBetween,\n                                    verticalAlignment = Alignment.CenterVertically,\n                                    modifier = Modifier\n                                        .fillMaxWidth()\n                                        .padding(horizontal = 4.dp, vertical = 2.dp)\n                                ) {\n                                    Text(\n                                        text = \"3-WAY COLOR WHEELS & OFFSET\",\n                                        color = TextPrimary,\n                                        fontSize = 10.sp,\n                                        fontWeight = FontWeight.Bold,\n                                        letterSpacing = 0.5.sp\n                                    )\n                                    Text(\n                                        text = \"Lift \342\200\242 Gamma \342\200\242 Gain \342\200\242 Offset\",\n                                        color = TextMuted,\n                                        fontSize = 8.5.sp,\n                                        fontFamily = FontFamily.Monospace\n                                    )\n                                }\n\n                                Spacer(modifier = Modifier.height(2.dp))\n\n                                // Horizontal scrolling row of the 4 color wheels\n                                Row(\n                                    modifier = Modifier\n                                        .fillMaxWidth()\n                                        .horizontalScroll(rememberScrollState())\n                                        .padding(vertical = 2.dp)\n                                ) {\n                                    ColorWheel(\n                                        title = \"Lift\",\n                                        accentColor = WheelLiftColor,\n                                        value = settings.lift,\n                                        onValueChange = { newLift -> onSettingsChange { it.copy(lift = newLift) } },\n                                        modifier = Modifier.width(155.dp)\n                                    )\n\n                                    ColorWheel(\n                                        title = \"Gamma\",\n                                        accentColor = WheelGammaColor,\n                                        value = settings.gamma,\n                                        onValueChange = { newGamma -> onSettingsChange { it.copy(gamma = newGamma) } },\n                                        modifier = Modifier.width(155.dp)\n                                    )\n\n                                    ColorWheel(\n                                        title = \"Gain\",\n                                        accentColor = WheelGainColor,\n                                        value = settings.gain,\n                                        onValueChange = { newGain -> onSettingsChange { it.copy(gain = newGain) } },\n                                        modifier = Modifier.width(155.dp)\n                                    )\n\n                                    ColorWheel(\n                                        title = \"Offset\",\n                                        accentColor = WheelOffsetColor,\n                                        value = settings.offset,\n                                        onValueChange = { newOffset -> onSettingsChange { it.copy(offset = newOffset) } },\n                                        modifier = Modifier.width(155.dp)\n                                    )\n                                }\n                            }\n                        }\n\n                        StudioToolTab.CURVES -> {\n                            // Custom Spline Curves Editor Canvas"
