            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                // Controls"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                Row(verticalAlignment = Alignment.CenterVertically) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    if (selectedPointIndex != null && selectedPointIndex != 0 && selectedPointIndex != currentPoints.size - 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        IconButton("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            onClick = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                selectedPointIndex?.let { idx ->"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                    val mutable = currentPoints.toMutableList()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                    mutable.removeAt(idx)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                    updateCurrentPoints(mutable)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                    selectedPointIndex = null"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            modifier = Modifier.size(28.dp).testTag(\"delete_curve_knot\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            Icon(Icons.Default.Delete, contentDescription = \"Delete point\", tint = ResolveRed, modifier = Modifier.size(16.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    IconButton("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        onClick = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            updateCurrentPoints(listOf(CurvePoint(0f, 0f), CurvePoint(1f, 1f)))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            selectedPointIndex = null"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        modifier = Modifier.size(28.dp).testTag(\"reset_curve\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        Icon(Icons.Default.Refresh, contentDescription = \"Reset curve\", tint = TextMuted, modifier = Modifier.size(16.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Spacer(modifier = Modifier.height(8.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // 2D Curves Graph Canvas"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Box("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                modifier = Modifier"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .fillMaxWidth()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .height(180.dp)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .clip(RoundedCornerShape(8.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .background(Color(0xFF0F1218))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .border(1.dp, StudioCardBorder, RoundedCornerShape(8.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .pointerInput(selectedChannel, currentPoints) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        detectTapGestures { tapOffset ->"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val xNorm = (tapOffset.x / size.width).coerceIn(0f, 1f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val yNorm = (1f - tapOffset.y / size.height).coerceIn(0f, 1f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            // Check if tapped near an existing knot (within 24dp)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val hitRadiusNorm = 24.dp.toPx() / size.width"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            var hitIndex: Int? = null"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            for (i in currentPoints.indices) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val pt = currentPoints[i]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val dx = pt.x - xNorm"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val dy = pt.y - yNorm"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                if (sqrt(dx * dx + dy * dy) < hitRadiusNorm) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                    hitIndex = i"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                    break"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            if (hitIndex != null) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                selectedPointIndex = hitIndex"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                // Add new knot point"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                val mutable = currentPoints.toMutableList()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                mutable.add(CurvePoint(xNorm, yNorm))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                updateCurrentPoints(mutable)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                selectedPointIndex = mutable.indexOfFirst { it.x == xNorm }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    .pointerInput(selectedChannel, currentPoints, selectedPointIndex) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        detectDragGestures { change, dragAmount ->"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            change.consume()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val idx = selectedPointIndex ?: return@detectDragGestures"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val dxNorm = dragAmount.x / size.width"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val dyNorm = -dragAmount.y / size.height // Screen Y is inverted"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val curPt = currentPoints[idx]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val newX = if (idx == 0) 0f else if (idx == currentPoints.size - 1) 1f else (curPt.x + dxNorm).coerceIn(0.02f, 0.98f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val newY = (curPt.y + dyNorm).coerceIn(0f, 1f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            val mutable = currentPoints.toMutableList()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            mutable[idx] = CurvePoint(newX, newY)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            updateCurrentPoints(mutable)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                Canvas(modifier = Modifier.fillMaxSize()) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val w = size.width"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val h = size.height"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 1. Grid Lines (10%, 25%, 50%, 75%, 90% IRE)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val gridFractions = floatArrayOf(0.1f, 0.25f, 0.5f, 0.75f, 0.9f)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    for (frac in gridFractions) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        val gx = frac * w"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        val gy = (1f - frac) * h"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        // Vertical"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        drawLine("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = Color(0xFF1B212D),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            start = Offset(gx, 0f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            end = Offset(gx, h),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            strokeWidth = 1.dp.toPx()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        // Horizontal"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        drawLine("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = Color(0xFF1B212D),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            start = Offset(0f, gy),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            end = Offset(w, gy),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            strokeWidth = 1.dp.toPx()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 2. Diagonal Neutral Reference Line (dashed)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    drawLine("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        color = Color(0xFF283244),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        start = Offset(0f, h),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        end = Offset(w, 0f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        strokeWidth = 1.dp.toPx(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        pathEffect = PathEffect.dashPathEffect(floatArrayOf(6f, 6f))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 3. Render Spline Curve Line & Gradient"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val lut = SamsungLogColorScience.buildSplineLut(currentPoints)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val curvePath = Path()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    curvePath.moveTo(0f, (1f - lut[0]) * h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    for (i in 1..255) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        val px = (i / 255f) * w"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        val py = (1f - lut[i]) * h"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        curvePath.lineTo(px, py)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // Gradient under curve"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    val fillPath = Path().apply {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        addPath(curvePath)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        lineTo(w, h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        lineTo(0f, h)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        close()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    drawPath("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        path = fillPath,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        brush = Brush.verticalGradient("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            colors = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                selectedChannel.color.copy(alpha = 0.15f),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                Color.Transparent"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // Draw solid curve line"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    drawPath("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        path = curvePath,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        color = selectedChannel.color,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        style = Stroke(width = 2.5.dp.toPx())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    // 4. Render Control Knot Points"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    currentPoints.forEachIndexed { index, pt ->"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        val px = pt.x * w"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        val py = (1f - pt.y) * h"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        val isSelected = index == selectedPointIndex"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        // Outer ring for selected point"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        if (isSelected) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            drawCircle("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                color = ResolveAmber,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                radius = 7.dp.toPx(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                center = Offset(px, py),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                                style = Stroke(width = 2.dp.toPx())"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        // Knot center"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        drawCircle("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = if (isSelected) ResolveAmber else selectedChannel.color,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            radius = 4.5.dp.toPx(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            center = Offset(px, py)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        drawCircle("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            color = Color.Black,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            radius = 2.dp.toPx(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            center = Offset(px, py)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Spacer(modifier = Modifier.height(4.dp))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Coordinates readout & hint"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Row("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                horizontalArrangement = Arrangement.SpaceBetween,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                modifier = Modifier.fillMaxWidth().padding(horizontal = 4.dp)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
