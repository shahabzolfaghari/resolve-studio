e = if (current.selectedCustomLutId == lutId) LutPreset.SAMSUNG_LOG_TO_REC709 else current.activeLut\\n        val newSelectedId = if (current.selectedCustomLutId == lutId) null else current.selectedCustomLutId\\n        updateSettings(description = \\\"Delete Custom LUT\\\", immediateCommit = true) {\\n            it.copy(\\n                customLuts = updatedList,\\n                activeLut = newActive,\\n                selectedCustomLutId = newSelectedId\\n            )\\n        }\\n    }\",\"StartLine\":173,\"TargetContent\":\"    fun onImportCubeLut(cubeContent: String) {\\n        val parsed = SamsungLogColorScience.parseCubeLut(cubeContent)\\n        if (parsed != null) {\\n            val (size, data) = parsed\\n            updateSettings(description = \\\"Import .cube LUT\\\", immediateCommit = true) {\\n                it.copy(\\n                    activeLut = LutPreset.CUSTOM_CUBE,\\n                    customLutSize = size,\\n                    customLutData = data\\n                )\\n            }\\n        }\\n    }\",\"TargetFile\":\"/app/src/main/java/com/example/ui/GradingViewModel.kt\",\"toolAction\":\"Editing GradingViewModel\",\"toolSummary\":\"Add custom LUT creation and deletion in ViewModel\"}"
