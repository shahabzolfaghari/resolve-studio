  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/color/SamsungLogColorScience.kt"
    start_line: 134
    end_line: 147
    content: "     * Compute RGB shift factors from trackball coordinates (x, y).\n     * Coordinate system:\n     * - Top (angle 90\302\260): Green\n     * - Bottom-Right (angle 330\302\260): Red/Magenta\n     * - Bottom-Left (angle 210\302\260): Blue/Cyan\n     */\n    private fun wheelToRgbShift(x: Float, y: Float): Triple<Float, Float, Float> {\n        val rShift = x * 0.866f - y * 0.5f\n        val gShift = y\n        val bShift = -x * 0.866f - y * 0.5f\n        return Triple(rShift, gShift, bShift)\n    }\n\n    /**"
    num_lines: 1178
    num_bytes: 48482
    line_range_bytes: 483
  }
