              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    Box(modifier = Modifier.fillMaxSize()) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        Canvas(modifier = Modifier.fillMaxSize().padding(horizontal = 6.dp, vertical = 6.dp)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
