            }
            lines {
              text: "        val h = bitmap.height"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Downsample for instant computation"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        val stepX = (w / 120).coerceAtLeast(1)"
