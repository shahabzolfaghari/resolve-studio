  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/components/MaskingOverlay.kt"
    end_line: 139
    content: "package com.example.ui.components\n\nimport androidx.compose.foundation.Canvas\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.border\nimport androidx.compose.foundation.gestures.detectDragGestures\nimport androidx.compose.foundation.gestures.detectTapGestures\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.shape.CircleShape\nimport androidx.compose.foundation.shape.RoundedCornerShape\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.filled.*\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.*\nimport androidx.compose.ui.Alignment\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.draw.clip\nimport androidx.compose.ui.geometry.CornerRadius\nimport androidx.compose.ui.geometry.Offset\nimport androidx.compose.ui.geometry.Size\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.graphics.PathEffect\nimport androidx.compose.ui.graphics.drawscope.Stroke\nimport androidx.compose.ui.input.pointer.pointerInput\nimport androidx.compose.ui.platform.testTag\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport com.example.model.MaskType\nimport com.example.model.PowerWindowMask\nimport com.example.ui.theme.*\nimport kotlin.math.*\n\nprivate enum class DragHandle {\n    CENTER,\n    HANDLE_TOP,\n    HANDLE_BOTTOM,\n    HANDLE_LEFT,\n    HANDLE_RIGHT,\n    HANDLE_TOP_LEFT,\n    HANDLE_TOP_RIGHT,\n    HANDLE_BOTTOM_LEFT,\n    HANDLE_BOTTOM_RIGHT,\n    NONE\n}\n\n/**\n * Interactive \'MaskingOverlay\' component placed directly over the video preview.\n * Allows drawing, resizing, feathering, and repositioning elliptical and rectangular\n * power windows for localized color grading (DaVinci Resolve style).\n */\n@Composable\nfun MaskingOverlay(\n    mask: PowerWindowMask,\n    onMaskChange: (PowerWindowMask) -> Unit,\n    modifier: Modifier = Modifier\n) {\n    if (mask.type == MaskType.NONE) return\n\n    var activeHandle by remember { mutableStateOf(DragHandle.NONE) }\n    var showQuickToolbar by remember { mutableStateOf(true) }\n\n    Box(\n        modifier = modifier\n            .fillMaxSize()\n            .pointerInput(mask) {\n                detectTapGestures(\n                    onDoubleTap = {\n                        // Reset mask to default center\n                        onMaskChange(mask.copy(centerX = 0.5f, centerY = 0.5f, radiusX = 0.3f, radiusY = 0.3f))\n                    },\n                    onTap = {\n                        showQuickToolbar = !showQuickToolbar\n                    }\n                )\n            }\n            .pointerInput(mask) {\n                detectDragGestures(\n                    onDragStart = { startOffset ->\n                        val w = size.width.toFloat()\n                        val h = size.height.toFloat()\n                        val cx = mask.centerX * w\n                        val cy = mask.centerY * h\n                        val rx = mask.radiusX * w\n                        val ry = mask.radiusY * h\n                        val hitRadius = 28.dp.toPx()\n\n                        // Check handles\n                        fun isHit(px: Float, py: Float) =\n                            sqrt((startOffset.x - px).pow(2) + (startOffset.y - py).pow(2)) < hitRadius\n\n                        activeHandle = when {\n                            isHit(cx, cy - ry) -> DragHandle.HANDLE_TOP\n                            isHit(cx, cy + ry) -> DragHandle.HANDLE_BOTTOM\n                            isHit(cx - rx, cy) -> DragHandle.HANDLE_LEFT\n                            isHit(cx + rx, cy) -> DragHandle.HANDLE_RIGHT\n                            isHit(cx - rx, cy - ry) -> DragHandle.HANDLE_TOP_LEFT\n                            isHit(cx + rx, cy - ry) -> DragHandle.HANDLE_TOP_RIGHT\n                            isHit(cx - rx, cy + ry) -> DragHandle.HANDLE_BOTTOM_LEFT\n                            isHit(cx + rx, cy + ry) -> DragHandle.HANDLE_BOTTOM_RIGHT\n                            isHit(cx, cy) -> DragHandle.CENTER\n                            // If clicked inside the shape, drag center\n                            (startOffset.x - cx).pow(2) / rx.pow(2) + (startOffset.y - cy).pow(2) / ry.pow(2) <= 1.0f ->\n                                DragHandle.CENTER\n                            else -> DragHandle.CENTER\n                        }\n                    },\n                    onDragEnd = { activeHandle = DragHandle.NONE },\n                    onDragCancel = { activeHandle = DragHandle.NONE }\n                ) { change, dragAmount ->\n                    change.consume()\n                    val w = size.width.toFloat()\n                    val h = size.height.toFloat()\n                    val dx = dragAmount.x / w\n                    val dy = dragAmount.y / h\n\n                    when (activeHandle) {\n                        DragHandle.CENTER -> {\n                            val newCx = (mask.centerX + dx).coerceIn(0.05f, 0.95f)\n                            val newCy = (mask.centerY + dy).coerceIn(0.05f, 0.95f)\n                            onMaskChange(mask.copy(centerX = newCx, centerY = newCy))\n                        }\n                        DragHandle.HANDLE_RIGHT -> {\n                            val newRx = (mask.radiusX + dx).coerceIn(0.05f, 0.5f)\n                            onMaskChange(mask.copy(radiusX = newRx))\n                        }\n                        DragHandle.HANDLE_LEFT -> {\n                            val newRx = (mask.radiusX - dx).coerceIn(0.05f, 0.5f)\n                            onMaskChange(mask.copy(radiusX = newRx))\n                        }\n                        DragHandle.HANDLE_BOTTOM -> {\n                            val newRy = (mask.radiusY + dy).coerceIn(0.05f, 0.5f)\n                            onMaskChange(mask.copy(radiusY = newRy))\n                        }\n                        DragHandle.HANDLE_TOP -> {\n                            val newRy = (mask.radiusY - dy).coerceIn(0.05f, 0.5f)\n                            onMaskChange(mask.copy(radiusY = newRy))\n                        }\n                        DragHandle.HANDLE_TOP_RIGHT, DragHandle.HANDLE_BOTTOM_RIGHT,\n                        DragHandle.HANDLE_TOP_LEFT, DragHandle.HANDLE_BOTTOM_LEFT -> {"
