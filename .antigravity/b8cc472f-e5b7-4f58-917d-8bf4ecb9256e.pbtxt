      thinking_signature: "\022\206\032\n\203\032\001i\024}\023\253b\372-\272\002MB\030|il\215;\021\374\353\364(\355\t6k\327D\261\aHpyC\023\004\353:2\206\rmU?\250\216\354\275M\236\234ta\226=\027\275\333\354.\3119rN\352\376Hk\265\337\364\3224\360h\376UU\202\371\032\307\022cm\261\312\300\r\021/~\305\206YA\204\372\aX\353\213\310\327\256\363\334#\234=\333\220\202\364\032L\323.&,\344>\216L\256\374\357-$#td\221\000\260\236[\303\341\257\a\221\033\217\0063\257D\207\203\274\367n\313)\323\232\343\037\351\235\347\221\326\275|\027 \347e\314\017:\340\"\bj\326r\nJ>\267\216\207j{\033\302\300n\255\3609B0X\365\017\365)\335\276]\313\000\325\036\274\225\321\000\343\254\247~\261ms\035q\310\310\354&oE@P\"\207\006OA9\361\\?i\340\235\000\223l\'m\r-\222\260\211\330\321$\360\310\203\260\350ap8\341{\366c4\346p\003\325\022{M!\336\236\327\337\271~\233\362\360\351\330)r\262\370Z3\'\206\"P\037\352 &\222*\314\2777\344b\000\340o\303H\317-\324\302_3{\311K\355\317\225\354\244X\256\263\020\243z\321Th\027\215U\306b\022T\260H{}\224\t\324\303v\221\324\236q7+\005|\367\230v~%5v>+u\223Pp\031C1\345\350\315E\306,W\372\253\3735v\361\036\312\246\227\270\" $\026\370\333\334\370Mm>\350!\253]\241\200l\313H\rK\330\032%9\n\202\002q\202&\232bO9\322\326\317\346P\272\357\223Z\326V\210\237\271\3279\252\310\027\347\005l#[\322=^T\372\301/\361\347E\200\212\020PC\317\024\217\260W\006\fhj\233\'\002\370\222\355A%\204\300\313\210`\a\326>L`\303K\322\352Uc\266D\021\213<L\231\335\235\353c\326\204\361K\234\355\023\372b\005\262\312\035n\034c\321`a\316P\0266\270\213q\247q\a\347\233\201u[*r\016\234{\342\240\324\023j\265|\233\337U\b6\331\254=\267\233(\003\306\356\246Y\324\260\246\017?\335\352\037n\367\351\353\275g\200m\214\231\324\207,\2343S\361x\254\f\240\264\227\320\355\b\363\020\335\331\020qjf\331C\360\264*\3042\366a_>\350\214\347n\'\033\322U\n\a\342\316)C\321\224\016\250\263\200\r~\330\340\320\240\000~|\274\205\326\212_7\237e\266\343(/~\343\252\0236l\003\215\000\243G\254l\3155\347\205L\271^y\267QPj\2760\2701\306;4nH,\211\207@\203