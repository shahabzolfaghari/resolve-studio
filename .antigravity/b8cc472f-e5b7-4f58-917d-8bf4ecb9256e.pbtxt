            }
            lines {
              text: "                    val grainB = sampleGrainValue(x, y, size, roughness, 2.7f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    val deltaR = grainR * density * strength * 0.18f"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    val deltaG = grainG * density * strength * 0.18f"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    val deltaB = grainB * density * strength * 0.18f"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    r = (r + deltaR).coerceIn(0f, 1f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    g = (g + deltaG).coerceIn(0f, 1f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    b = (b + deltaB).coerceIn(0f, 1f)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                val ir = (r * 255f).toInt()"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                val ig = (g * 255f).toInt()"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                val ib = (b * 255f).toInt()"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                pixels[idx] = AndroidColor.rgb(ir, ig, ib)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                val ir = (r * 255f).toInt().coerceIn(0, 255)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val ig = (g * 255f).toInt().coerceIn(0, 255)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                val ib = (b * 255f).toInt().coerceIn(0, 255)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                pixels[idx] = (0xFF shl 24) or (ir shl 16) or (ig shl 8) or ib"
