      thinking_signature: "\022\367\001\n\364\001\001i\024}\023\276\311]l\224\373\232\320\232\260ac\360b\216\325\005Y\317\346\237\215\264!\n`U\212\224\304\322\\\210\231\031t\370l\005&\035\304\020!\241\331\n\341\001\254jUX\304\202=S!\036\206\306\f7\"\215;\\\3438\304\222\223\225)v\225\211BeO\222\272\307\311\342\266\306~}[Z\241\024KG\213\317\323 y\246\2470\a\260h\3766\\\315&.;\362\034\277S>kJ\226\346Rr\200\213\216\016\277\210X\322[\023^\367\212\177\215>\026\367h\\\301\241m\334O\356c\277g\232\271\312\322\240\032\275\"\266t\313\265^\366krq*\240\337\365\f\327\256T\005\325\320\302\260:v\340\247J\033\203\0253\235\321u[$/$\350\226\0205B\242\206\205\342S/\206D\275@\023\2571\210\315\203Q\005\016[#\0365\216\201|^\234\211\374|\326\276\216!"
