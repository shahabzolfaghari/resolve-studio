              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        modifier = Modifier.size(24.dp).testTag(\"reset_wheel_${title.lowercase()}\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    ) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                        Icon("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            imageVector = Icons.Default.Refresh,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                            contentDescription = \"Reset $title\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
