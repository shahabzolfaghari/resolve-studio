      thinking_signature: "\022\273\020\n\270\020\001i\024}\023_\361\313\351/*3?\262Loy;\271\024cx\233\357)\253\336&v\227\tW\311\356\246\327\362\266\220\346\366\000\275\311\330\362\252F\240\233\023F\376\350Q\034\236=\221\016\343\226\302O\t\200\371\245\334\341v\335\nB\034\225\0017\322\222\201~Z|yQ\316\313[\201[\r\370\\=\2530\270\333\304\237@\250\004k\266\335I$\212\255\243\211T~%i\375/Og}\367\f\240\344\345\352\355\322\315s\277k\310\004\270\f\347\037\370\331\203v\310-\003\336\215V\016\033\311F\363n\357\2470\317\323&\024$F3O\343h\323a\203h\016FBx \t\a\325\335\306MQ\343Bn\032C$*\035\310I\001&\227\2175s\n\ndfA\006\217\a\'P$\372\002[\350\334\375|\343,\365`\r1\203Lhq\3732\350#:^b\330\224J\220/*\203\212\370\263\221\377\t\237\254\233kZ\251\325\032p\343\251\366\203tB\341:\201\237\323\225\3270\210Y\222\363\366\362\3514\303\254\312M\351\336\'\373*\202\022\2604o{\003\265\332J\003\325\016\356\317\001(\0049eQ\024x\246\t\353U\020>E\004o*]\253J\365\274w\234\372\224\226\314\027\376C\'\376\216\337\344\317@b!y:\024\027\022\352\272A\304\354\211U\220\276\204\334~C\211\034>)`*\000\253e\277\374\257G\351\037Q\253\230p\005\037\3678w\023\341\224\272\204-j\273+[-O\260\223sO\204\356\316>\211\372\020\327\330b\356\357j\016\305\017\323f\230\003zS\3175O\awB\233\311h\3079\375\204j*\344Z(h8\033\f\354O\356\31056\360+\b\232\001\321*\250\322\023\213\234I\367\314\345\351FHD\001\202C\314\212N `\336B\313\353\2367P\226_\374a\302b\352\375\266\253\377A\244\000\023l\214\005\372\346\334\330`^\266*\224\326\325\a\323\367\353\275| \363W\336\261\320\240\336\025\226\023/\356\225\342t\361/8\001\242~\327pO<\273\333\223d\266m\246\370u\0335\366\f\373*\r\004\005=@18\262\\!\364\030V\025\356\3006\215\244\350g\003(\324\213\216\243\035\346\321\025^m\221\b\035\335<\037\204\037y[\305=G\263~\027b\213S\361\324\272xe\376\034\303\306\255\343&Z\313#\251\206\2500\177\223{\314\000\333\3760=R!.X\374\336\275\2713\347\200 \207\325\037\355f\371g\210A\313I\022I\263\344E\210\205\035\310?;\266\301\360\024\222L\r\313\366t\f\320\310\227\303^\2